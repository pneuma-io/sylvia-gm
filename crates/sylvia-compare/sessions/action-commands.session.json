{
  "name": "action-commands",
  "description": "The direct action and TURN commands on an SRD Lite campaign (stand-in model, no turn run): execute_action's argument refusals in Python's order, its authority refusals (unknown campaign, stale revision, unknown tool or package, another TURN, the player writer, invalid parameters), a d20_test check, its replay and both idempotency conflicts; resolve_mechanics_choice with no pending choice; retryable_interruption with no interruption; open_turn and complete_turn (refusals, completing the GM's TURN twice, opening another, acting in it, completing it); begin_campaign_construction's refusals; then the display snapshot and shut down.",
  "standin": true,
  "summarise_tables": [
    "^package_",
    "^packages$"
  ],
  "rules": {
    "ignore_keys": [
      "elapsed_ms",
      "quiet_ms",
      "rows/payload_hash",
      "_d20_test/results",
      "_d20_test/total",
      "d20_test/results",
      "d20_test/total",
      "context/_adjusted_total",
      "narration_facts/adjusted_total",
      "equation/roll",
      "equation/total",
      "details/value",
      "diagnostic_id"
    ],
    "alias": [
      {
        "name": "inference",
        "pattern": "inference-[0-9a-f]{32}",
        "keys": [
          "message_id",
          "inference_id"
        ]
      },
      {
        "name": "action",
        "pattern": "action-[0-9a-f]{32}",
        "keys": [
          "action_id",
          "message_id",
          "content"
        ]
      },
      {
        "name": "provider-call",
        "pattern": "provider-[0-9a-f]{32}",
        "keys": [
          "idempotency_key"
        ]
      }
    ],
    "scrub": [
      {
        "pattern": "data: [A-Za-z0-9+/=]{40,}",
        "with": "data: <protected credential>"
      },
      {
        "pattern": "\"(_?adjusted_total)\":[0-9]+",
        "with": "\"$1\":<roll>"
      },
      {
        "pattern": "\"results\":\\[[0-9]+\\],\"sides\":20,\"total\":[0-9]+",
        "with": "\"results\":[<roll>],\"sides\":20,\"total\":<roll>"
      },
      {
        "pattern": "\"label\":\"D20 results\",\"value\":\\[[0-9]+\\]",
        "with": "\"label\":\"D20 results\",\"value\":[<roll>]"
      },
      {
        "pattern": "\"roll\":[0-9]+,\"total\":[0-9]+",
        "with": "\"roll\":<roll>,\"total\":<roll>"
      }
    ],
    "volatile_files": [
      "^diagnostics/"
    ]
  },
  "steps": [
    {
      "method": "save_provider_settings",
      "expect_ok": true,
      "params": {
        "provider_id": "standin",
        "preset_id": "custom",
