{
  "name": "opening-retry",
  "description": "A campaign's opening fails mid-stream (the stand-in's [fail-opening] marker in its name), then Manual Retry regenerates it through the narration-only Retry, and repeating the same Retry identity replays it.",
  "standin": true,
  "summarise_tables": ["^package_", "^packages$"],
  "rules": {
    "ignore_keys": [
      "elapsed_ms",
      "quiet_ms",
      "activity_timing/revision",
      "diagnostic_id"
    ],
    "alias": [
      {
        "name": "inference",
        "pattern": "inference-[0-9a-f]{32}",
        "keys": [
          "message_id",
          "inference_id"
        ]
      },
      {
        "name": "interruption",
        "pattern": "^interruption-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "keys": [
          "interruption_id",
          "redirect_interruption_id"
        ]
      }
    ],
    "scrub": [
      {
        "pattern": "data: [A-Za-z0-9+/=]{40,}",
        "with": "data: <protected credential>"
      },
      {
        "pattern": "\"interruption_id\":\"interruption-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\"",
        "with": "\"interruption_id\":\"interruption-<retry data>\""
      }
    ],
    "volatile_files": [
      "^diagnostics/"
    ],
    "ignore_headers_row_8": [
      "User-Agent",
      "Accept-Encoding",
      "Connection",
      "X-Stainless-*"
    ],
    "header_name_case_row_40": true
  },
  "steps": [
    {"method": "save_provider_settings", "expect_ok": true, "params": {"provider_id": "standin", "preset_id": "custom", "display_name": "Stand-in", "base_url": "${standin_url}", "credential": "${standin_key}", "model_id": "${standin_model}", "model_name": "Stand-in Narrator", "context_window": 4000000, "max_output_tokens": 4096, "transport": "chat_completions"}},
    {"method": "provider_settings"},
    {"method": "model_choices", "expect_ok": true, "save": {"provider_id": "/result/0/provider_id", "model_id": "/result/0/model_id"}},
    {"method": "create_guided_campaign_draft", "expect_ok": true, "params": {"operation_id": "storm-draft", "display_name": "Storm Courier [fail-opening]", "provider_id": "${provider_id}", "model_id": "${model_id}"}, "save": {"campaign_id": "/result/campaign_id", "builder_session_id": "/result/builder_session_id"}},
    {"method": "advance_guided_campaign_draft", "expect_ok": true, "params": {"operation_id": "storm-ruleset", "campaign_id": "${campaign_id}", "builder_session_id": "${builder_session_id}", "expected_construction_revision": 0, "current_step": "ruleset", "visible_answer": "No Ruleset", "answer": {"candidate_id": null}}},
    {"method": "advance_guided_campaign_draft", "expect_ok": true, "params": {"operation_id": "storm-name", "campaign_id": "${campaign_id}", "builder_session_id": "${builder_session_id}", "expected_construction_revision": 1, "current_step": "name", "visible_answer": "Storm Courier", "answer": {"display_name": "Storm Courier"}}},
    {"method": "advance_guided_campaign_draft", "expect_ok": true, "params": {"operation_id": "storm-boundaries", "campaign_id": "${campaign_id}", "builder_session_id": "${builder_session_id}", "expected_construction_revision": 2, "current_step": "boundaries_preferences", "visible_answer": "None; Mystery", "answer": {"boundaries": "None", "preferences": "Mystery"}}},
    {"method": "advance_guided_campaign_draft", "expect_ok": true, "params": {"operation_id": "storm-requests", "campaign_id": "${campaign_id}", "builder_session_id": "${builder_session_id}", "expected_construction_revision": 3, "current_step": "specific_requests", "visible_answer": "No additional requests", "answer": {"no_additional_requests": true, "requests": ""}}},
    {"method": "start_guided_campaign", "expect_ok": true, "timeout_s": 600, "params": {"operation_id": "storm-start", "campaign_id": "${campaign_id}", "builder_session_id": "${builder_session_id}", "display_name": "Storm Courier [fail-opening]", "candidate_id": null, "setting_id": null, "plan_id": null, "player_character_id": null, "companion_ids": [], "premise": "A courier shelters from a storm."}},
    {"method": "finalize_campaign_construction", "expect_ok": true, "timeout_s": 600, "params": {"campaign_id": "${campaign_id}", "dm_provider_id": "${provider_id}", "dm_model_id": "${model_id}"}, "save": {"session_id": "/result/handoff/dm_session_id", "turn_id": "/result/dm_turn_id", "dm_attempt_id": "/result/dm_attempt_id"}},
    {"method": "campaign_index", "expect_ok": true},
    {"method": "start_dm_session", "timeout_s": 600, "params": {"campaign_id": "${campaign_id}", "session_id": "${session_id}", "turn_id": "${turn_id}"}},
    {"method": "campaign_index", "expect_ok": true, "save": {"turn_id": "/result/0/turn_id"}},
    {"method": "player_projection_page", "params": {"campaign_id": "${campaign_id}", "after_sequence": 0, "load_id": null}},
    {"method": "session_history_page", "params": {"session_id": "${session_id}", "before_sequence": null, "limit": 50}},
    {"method": "retryable_interruption", "expect_ok": true, "params": {"campaign_id": "${campaign_id}", "failed_attempt_id": "${dm_attempt_id}"}, "save": {"interruption_id": "/result/interruption_id"}},
    {"method": "manual_retry_session", "timeout_s": 600, "params": {"session_id": "${session_id}", "interruption_id": "${interruption_id}", "retry_id": "retry-opening-1"}},
    {"method": "manual_retry_session", "timeout_s": 600, "params": {"session_id": "${session_id}", "interruption_id": "${interruption_id}", "retry_id": "retry-opening-1"}},
    {"method": "player_projection_page", "params": {"campaign_id": "${campaign_id}", "after_sequence": 0, "load_id": null}},
    {"method": "session_history_page", "params": {"session_id": "${session_id}", "before_sequence": null, "limit": 50}},
    {"method": "campaign_index", "expect_ok": true},
    {"method": "shutdown"}
  ]
}
