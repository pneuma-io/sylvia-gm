{
  "name": "player-action-refusals",
  "description": "A player's direct action before any result card offers a control, on an SRD Lite campaign after one d20_test check (stand-in model): execute_player_action and preview_player_action refuse a source or selection that is not an object, every missing or invalid field in Python's order, an unknown campaign or session, a stale revision, and each source form (a result card's button, a panel action, a mechanics choice) malformed, with an invalid identity, out of range, or naming nothing saved (the check's card has no buttons); then shut down. Shipped result cards carry no player controls, so a real control needs a Ruleset that declares one.",
  "standin": true,
  "summarise_tables": [
    "^package_",
    "^packages$"
  ],
  "rules": {
    "ignore_keys": [
      "elapsed_ms",
      "quiet_ms",
      "rows/payload_hash",
      "_d20_test/results",
      "_d20_test/total",
      "d20_test/results",
      "d20_test/total",
      "context/_adjusted_total",
      "narration_facts/adjusted_total",
      "equation/roll",
      "equation/total",
      "details/value",
      "diagnostic_id"
    ],
    "alias": [
      {
        "name": "inference",
        "pattern": "inference-[0-9a-f]{32}",
        "keys": [
          "message_id",
          "inference_id"
        ]
      },
      {
        "name": "action",
        "pattern": "action-[0-9a-f]{32}",
        "keys": [
          "action_id",
          "message_id",
          "content"
        ]
      },
      {
        "name": "provider-call",
        "pattern": "provider-[0-9a-f]{32}",
        "keys": [
          "idempotency_key"
        ]
      }
    ],
    "scrub": [
      {
        "pattern": "data: [A-Za-z0-9+/=]{40,}",
        "with": "data: <protected credential>"
      },
      {
        "pattern": "\"(_?adjusted_total)\":[0-9]+",
        "with": "\"$1\":<roll>"
      },
      {
        "pattern": "\"results\":\\[[0-9]+\\],\"sides\":20,\"total\":[0-9]+",
        "with": "\"results\":[<roll>],\"sides\":20,\"total\":<roll>"
      },
      {
        "pattern": "\"label\":\"D20 results\",\"value\":\\[[0-9]+\\]",
        "with": "\"label\":\"D20 results\",\"value\":[<roll>]"
      },
      {
        "pattern": "\"roll\":[0-9]+,\"total\":[0-9]+",
        "with": "\"roll\":<roll>,\"total\":<roll>"
      }
    ],
    "volatile_files": [
      "^diagnostics/"
    ]
  },
