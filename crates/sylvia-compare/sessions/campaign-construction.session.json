{
  "name": "campaign-construction",
  "description": "The campaign construction commands outside the guided interview (stand-in model): confirm_new_campaign's refusals in Python's order (an owner-assigned session, the candidate, the provider and model, the chat start, the name, the turn and the skill), a confirmation with no packages and its replay and identity conflict, and one with SRD Lite's installed candidate; begin_campaign_construction on each (an unknown lane, a stale revision, the begin, its replay and conflict, the brief in the Builder session); complete_campaign_construction's refusals, completion, replay and conflict, and an unknown campaign; then the index and snapshot, and shut down. Python's confirmation makes uuid4 campaign identities, so the campaign and lock identities are aliases, and six hash cells whose payloads hold them are ignored by exact pointer: the two Builder sessions' agent_sessions.payload_sha256 and the four begin and complete campaign_operations.semantic_payload_sha256. Those columns are compared byte for byte, with fixed identities and no ignore rule, for the same operation kinds and the Builder sessions in campaign-snapshots (and action-commands).",
  "standin": true,
  "summarise_tables": [
    "^package_",
    "^packages$"
  ],
  "rules": {
    "ignore_keys": [
      "diagnostic_id"
    ],
    "alias": [
      {
        "name": "campaign",
        "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}",
        "keys": [
          "campaign_id"
        ]
      },
      {
        "name": "lock",
        "pattern": "lock-[0-9a-f]{40}",
        "keys": [
          "authority_lock_id",
          "lock_id",
          "basis_lock_id",
          "current_lock_id"
        ]
      }
    ],
    "ignore_pointers": [
      "/database/tables/agent_sessions/rows/0/payload_sha256",
      "/database/tables/agent_sessions/rows/1/payload_sha256",
      "/database/tables/campaign_operations/rows/2/semantic_payload_sha256",
      "/database/tables/campaign_operations/rows/3/semantic_payload_sha256",
      "/database/tables/campaign_operations/rows/4/semantic_payload_sha256",
      "/database/tables/campaign_operations/rows/5/semantic_payload_sha256"
    ],
    "scrub": [
      {
        "pattern": "data: [A-Za-z0-9+/=]{40,}",
        "with": "data: <protected credential>"
      }
    ],
    "volatile_files": [
      "^diagnostics/"
    ]
  },
  "steps": [
    {
      "method": "save_provider_settings",
      "expect_ok": true,
      "params": {
        "provider_id": "standin",
        "preset_id": "custom",
        "display_name": "Stand-in",
        "base_url": "${standin_url}",
        "credential": "${standin_key}",
        "model_id": "${standin_model}",
        "model_name": "Stand-in Narrator",
        "context_window": 4000000,
        "max_output_tokens": 4096,
        "transport": "chat_completions"
      }
    },
    {
      "method": "model_choices",
      "expect_ok": true,
      "save": {
        "provider_id": "/result/0/provider_id",
        "model_id": "/result/0/model_id"
      }
    },
    {
      "method": "package_candidates",
      "expect_ok": true,
      "save": {
        "srd": "/result/1/candidate_id"
      }
    },
    {
      "method": "confirm_new_campaign",
      "params": {
        "builder_session_id": "session-mine"
      }
    },
    {
      "method": "confirm_new_campaign",
      "params": {}
    },
    {
      "method": "confirm_new_campaign",
      "params": {
        "operation_id": "confirm-quick",
        "candidate_id": ""
      }
    },
    {
      "method": "confirm_new_campaign",
      "params": {
