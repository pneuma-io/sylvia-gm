          "id": "t1",
          "method": "trash_campaign",
          "params": {
            "operation_id": "storm-trash",
            "campaign_id": "${campaign_id}",
            "expected_revision": "${revision}",
            "designated_session_id": "${dm_session_id}"
          }
        }
      },
      "save": {
        "trashed_revision": "/json/result/resulting_revision"
      }
    },
    {
      "http": {
        "method": "POST",
        "path": "/api/command",
        "headers": [
          [
            "Origin",
