 "trigger_identity": [
  [
   "campaign_state_owner_delete_requires_empty",
   "create trigger campaign_state_owner_delete_requires_empty before delete on campaign_state_namespace_owners when exists ( select 1 from campaign_state as state where state.campaign_id = old.campaign_id and state.namespace = old.namespace ) begin select raise(abort, 'campaign state namespace owner still has state'); end"
  ],
  [
   "campaign_state_owner_immutable",
   "create trigger campaign_state_owner_immutable before update on campaign_state_namespace_owners begin select raise(abort, 'campaign state namespace owner is immutable'); end"
  ],
  [
   "campaign_state_owner_matches_current_lock",
   "create trigger campaign_state_owner_matches_current_lock before insert on campaign_state_namespace_owners begin select case when ( new.owner_package_id is null and exists ( select 1 from campaigns as campaign join campaign_lock_memberships as membership on membership.lock_id = campaign.current_lock_id where campaign.campaign_id = new.campaign_id ) ) or ( new.owner_package_id is not null and not exists ( select 1 from campaigns as campaign join campaign_lock_memberships as membership on membership.lock_id = campaign.current_lock_id where campaign.campaign_id = new.campaign_id and membership.package_id = new.owner_package_id ) ) or exists ( select 1 from campaigns as campaign join campaign_lock_memberships as membership on membership.lock_id = campaign.current_lock_id where campaign.campaign_id = new.campaign_id and new.namespace like membership.package_id || '.%' and membership.package_id <> new.owner_package_id ) then raise(abort, 'campaign state namespace owner conflicts with current lock') end; end"
  ],
  [
   "campaign_state_owner_required_insert",
   "create trigger campaign_state_owner_required_insert before insert on campaign_state begin select case when not exists ( select 1 from campaign_state_namespace_owners as owner where owner.campaign_id = new.campaign_id and owner.namespace = new.namespace ) then raise(abort, 'campaign state namespace owner is required') end; end"
  ],
  [
   "campaign_state_owner_required_update",
   "create trigger campaign_state_owner_required_update before update of campaign_id, namespace on campaign_state begin select case when not exists ( select 1 from campaign_state_namespace_owners as owner where owner.campaign_id = new.campaign_id and owner.namespace = new.namespace ) then raise(abort, 'campaign state namespace owner is required') end; end"
  ],
  [
   "mutation_requires_matching_namespace_owner",
   "create trigger mutation_requires_matching_namespace_owner before insert on mutations begin select case when not exists ( select 1 from actions as action join campaign_state_namespace_owners as owner on owner.campaign_id = new.campaign_id and owner.namespace = new.namespace where action.campaign_id = new.campaign_id and action.action_id = new.action_id and owner.owner_package_id is not null and owner.owner_package_id = action.package_id ) then raise(abort, 'mutation package does not own state namespace') end; end"
  ]
 ],
