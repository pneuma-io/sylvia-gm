{
 "schema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sylvia-gm:content:panel-declaration:1",
  "title": "Compact Ruleset panel declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
   "id",
   "capability",
   "renderer",
   "source"
  ],
  "properties": {
   "id": {
    "type": "string",
    "minLength": 1,
    "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])",
    "description": "Unique panel identity within the package."
   },
   "capability": {
    "type": "string",
    "minLength": 1,
    "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])",
    "description": "A capability declared by the same package."
   },
   "renderer": {
    "enum": [
     "party",
     "encounter",
     "inventory",
     "objectives",
     "unit_list",
     "key_value",
     "text",
     "tactical_grid",
     "coordinate_map",
     "network_graph",
     "piece_table"
    ]
   },
   "source": {
    "$ref": "#/$defs/source"
   },
   "title": {
    "type": "string",
    "minLength": 1,
    "maxLength": 256,
    "description": "Defaults to id in compact source."
   },
   "icon": {
    "type": "string",
    "minLength": 1,
    "maxLength": 256,
    "default": "\u25c7"
   },
   "group": {
    "oneOf": [
     {
      "type": "null"
     },
     {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])"
     }
    ],
    "default": null
   },
   "order": {
    "type": "integer",
    "minimum": 0,
    "maximum": 10000,
    "description": "Defaults to the surface's zero-based source-list position."
   },
   "default_size": {
    "type": "integer",
    "minimum": 96,
    "maximum": 2000,
    "default": 180
   },
   "minimum_size": {
    "type": "integer",
    "minimum": 96,
    "maximum": 2000,
    "default": 96
   },
   "default_placement": {
    "enum": [
     "docked",
     "floating",
     "window"
    ],
    "default": "docked"
   },
   "allowed_placements": {
    "type": "array",
    "minItems": 1,
    "maxItems": 3,
    "uniqueItems": true,
    "items": {
     "enum": [
      "docked",
      "floating",
      "window"
     ]
    },
    "default": [
     "docked",
     "window"
    ]
   },
   "actions": {
    "type": "array",
    "maxItems": 16,
    "items": {
     "$ref": "#/$defs/action"
    },
    "default": []
   }
  },
  "$defs": {
   "source": {
    "oneOf": [
     {
      "$ref": "#/$defs/state_source"
     },
     {
      "$ref": "#/$defs/literal_source"
     },
     {
      "$ref": "#/$defs/participant_source"
     },
     {
      "$ref": "#/$defs/campaign_plan_source"
     },
     {
      "$ref": "#/$defs/object_source"
     },
     {
      "$ref": "#/$defs/keyed_values_source"
     }
    ]
   },
   "literal_source": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "value"
    ],
    "properties": {
     "kind": {
      "const": "literal"
     },
     "value": {
      "type": "object"
     }
    }
   },
   "state_source": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "namespace",
     "key"
    ],
    "properties": {
     "kind": {
      "const": "state"
     },
     "namespace": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])"
     },
     "key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])"
     }
    }
   },
   "participant_source": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "kinds"
    ],
    "properties": {
     "kind": {
      "const": "participants"
     },
     "kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
       "type": "string",
       "minLength": 1,
       "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])"
      }
     }
    }
   },
   "campaign_plan_source": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "path"
    ],
    "properties": {
     "kind": {
      "const": "campaign_plan"
     },
     "path": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
       "type": "string",
       "minLength": 1,
       "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])"
      }
     }
    }
   },
   "keyed_values_source": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "entries"
    ],
    "description": "Map resolved string keys to values; omit empty keys and null values.",
    "properties": {
     "kind": {
      "const": "keyed_values"
     },
     "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "key",
        "value"
       ],
       "properties": {
        "key": {
         "$ref": "#/$defs/source"
        },
        "value": {
         "$ref": "#/$defs/source"
        }
       }
      }
     }
    }
   },
   "object_source": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "fields"
    ],
    "properties": {
     "kind": {
      "const": "object"
     },
     "fields": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
       "type": "string",
       "minLength": 1,
       "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])"
      },
      "additionalProperties": {
       "$ref": "#/$defs/source"
      }
     }
    }
   },
   "action": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "label",
     "intent",
     "params"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])"
     },
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
     },
     "intent": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])",
      "description": "An exact public tool name in this package."
     },
     "params": {
      "type": "object",
      "description": "Open fixed Ruleset parameter data.",
      "additionalProperties": true
     },
     "bindings": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
       "type": "string",
       "minLength": 1,
       "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])"
      },
      "additionalProperties": {
       "enum": [
        "actor",
        "aim_point",
        "area",
        "declared_action",
        "destination",
        "device",
        "link",
        "node",
        "orientation",
        "path",
        "piece",
        "remote_function",
        "route_step",
        "target",
        "zone"
       ]
      }
     },
     "spatial_preview": {
      "enum": [
       "segment"
      ]
     },
     "target_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "description": "Coordinate target binding uses the map's admitted mechanical reference."
     },
     "actor_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "description": "Coordinate map actor binding reads this entity metadata field."
     }
    }
   }
  },
  "allOf": [
   {
    "if": {
     "properties": {
      "renderer": {
       "const": "piece_table"
      }
     }
    },
    "then": {
     "properties": {
      "actions": {
       "items": {
        "properties": {
         "bindings": {
          "additionalProperties": {
           "enum": [
            "piece"
           ]
          }
         }
        }
       }
      }
     }
    }
   },
   {
    "if": {
     "properties": {
      "renderer": {
       "const": "coordinate_map"
      }
     }
    },
    "then": {
     "properties": {
      "actions": {
       "items": {
        "properties": {
         "bindings": {
          "additionalProperties": {
           "enum": [
            "actor",
            "target",
            "aim_point",
            "declared_action"
           ]
          }
         }
        }
       }
      }
     }
    }
   },
   {
    "if": {
     "properties": {
      "renderer": {
       "enum": [
        "party",
        "unit_list"
       ]
      }
     }
    },
    "then": {
     "properties": {
      "actions": {
       "items": {
        "properties": {
         "bindings": {
          "additionalProperties": {
           "enum": [
            "actor"
           ]
          }
         }
        }
       }
      }
     }
    }
   },
   {
    "if": {
     "properties": {
      "renderer": {
       "const": "tactical_grid"
      }
     }
    },
    "then": {
     "properties": {
      "actions": {
       "items": {
        "properties": {
         "bindings": {
          "additionalProperties": {
           "enum": [
            "actor",
            "zone",
            "device",
            "destination",
            "path",
            "target",
            "aim_point",
            "area",
            "orientation",
            "declared_action"
           ]
          }
         }
        }
       }
      }
     }
    }
   },
   {
    "if": {
     "properties": {
      "renderer": {
       "const": "network_graph"
      }
     }
    },
    "then": {
     "properties": {
      "actions": {
       "items": {
        "properties": {
         "bindings": {
          "additionalProperties": {
           "enum": [
            "actor",
            "node",
            "link",
            "route_step",
            "remote_function",
            "declared_action"
           ]
          }
         }
        }
       }
      }
     }
    }
   },
   {
    "if": {
     "properties": {
      "renderer": {
       "not": {
        "enum": [
         "party",
         "unit_list",
         "inventory",
         "tactical_grid",
         "coordinate_map",
         "network_graph",
         "piece_table"
        ]
       }
      }
     }
    },
    "then": {
     "properties": {
      "actions": {
       "items": {
        "not": {
         "required": [
          "bindings"
         ]
        }
       }
      }
     }
    }
   }
  ]
 },
 "example": {
  "id": "party",
  "capability": "example.rules.party",
  "renderer": "party",
  "source": {
   "kind": "participants",
   "kinds": [
    "player",
    "companion"
   ]
  }
 },
 "notes": [
  "The compact compiler supplies omitted display, size, placement, order, and actions fields before package validation.",
  "minimum_size must not exceed default_size, and default_placement must occur in allowed_placements.",
  "Capability and action intent references require package-level checks.",
  "Binding keys must not overlap params keys; binding sources must be unique within an action.",
  "Object source nesting is limited to depth 3 by the package validator.",
  "Small-label validation also rejects unsafe text; its byte-level rule remains procedural here."
 ],
 "file": "ruleset-source.yaml:ui_surfaces"
}
