{
 "schema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pneuma.io/sylvia-gm/admitted-json-schema-subset.schema.json",
  "title": "Sylvia GM admitted JSON-schema subset",
  "$ref": "#/$defs/schema",
  "$defs": {
   "schema": {
    "type": "object",
    "required": [
     "type"
    ],
    "properties": {
     "$id": {
      "type": "string",
      "minLength": 1
     },
     "description": {
      "type": "string"
     },
     "type": {
      "oneOf": [
       {
        "enum": [
         "string",
         "integer",
         "number",
         "boolean",
         "object",
         "array",
         "null"
        ]
       },
       {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "uniqueItems": true,
        "items": {
         "enum": [
          "string",
          "integer",
          "number",
          "boolean",
          "object",
          "array",
          "null"
         ]
        },
        "contains": {
         "const": "null"
        }
       }
      ]
     },
     "properties": {
      "type": "object",
      "additionalProperties": {
       "$ref": "#/$defs/schema"
      }
     },
     "required": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "uniqueItems": true
     },
     "additionalProperties": {
      "oneOf": [
       {
        "type": "boolean"
       },
       {
        "$ref": "#/$defs/schema"
       }
      ]
     },
     "items": {
      "$ref": "#/$defs/schema"
     },
     "enum": {
      "type": "array"
     },
     "minimum": {
      "type": "number"
     },
     "maximum": {
      "type": "number"
     },
     "minLength": {
      "type": "integer",
      "minimum": 0
     },
     "maxLength": {
      "type": "integer",
      "minimum": 0
     },
     "minItems": {
      "type": "integer",
      "minimum": 0
     },
     "maxItems": {
      "type": "integer",
      "minimum": 0
     },
     "uniqueItems": {
      "type": "boolean"
     },
     "allOf": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
       "$ref": "#/$defs/schema"
      }
     },
     "if": {
      "$ref": "#/$defs/schema"
     },
     "then": {
      "$ref": "#/$defs/schema"
     },
     "contains": {
      "$ref": "#/$defs/schema"
     },
     "minContains": {
      "type": "integer",
      "minimum": 0
     },
     "x-sylvia-gm-reference": {
      "type": "string"
     },
     "x-sylvia-gm-derived": {
      "type": "boolean"
     },
     "x-sylvia-gm-model-hidden": {
      "type": "boolean"
     },
     "x-sylvia-gm-model-required": {
      "type": "boolean"
     }
    },
    "additionalProperties": false,
    "dependentRequired": {
     "if": [
      "then"
     ],
     "then": [
      "if"
     ],
     "minContains": [
      "contains"
     ]
    },
    "allOf": [
     {
      "if": {
       "required": [
        "contains"
       ]
      },
      "then": {
       "properties": {
        "type": {
         "enum": [
          "array",
          [
           "array",
           "null"
          ],
          [
           "null",
           "array"
          ]
         ]
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "type": {
         "const": "object"
        }
       },
       "required": [
        "type"
       ]
      },
      "then": {
       "properties": {
        "properties": {
         "type": "object"
        },
        "required": {
         "type": "array"
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "type": {
         "enum": [
          "array",
          [
           "array",
           "null"
          ],
          [
           "null",
           "array"
          ]
         ]
        }
       },
       "required": [
        "type"
       ]
      },
      "then": {
       "required": [
        "items"
       ]
      }
     }
    ]
   }
  }
 },
 "example": {
  "type": "object",
  "properties": {
   "name": {
    "type": "string",
    "minLength": 1,
    "description": "The character's chosen name."
   }
  },
  "required": [
   "name"
  ],
  "additionalProperties": false
 },
 "notes": [
  "Descriptions explain authored fields; they are guidance, not executable validation rules.",
  "allOf combines 1\u2013256 typed schemas. if/then must be paired. Array contains requires at least minContains matching items (one by default). These can express build prerequisites without executable package code; every nested schema still requires an explicit type.",
  "This definition mirrors application/schema_admission.py. Contextual owners may impose tighter rules, including an object root, explicit extension policy, or matching $id.",
  "The runtime definition-row subset is smaller: additionalProperties is boolean-only and annotations plus array-size constraints are unavailable there.",
  "Schema validation is deterministic and data-only; it provides no arbitrary code or formula execution."
 ],
 "file": "Package tool, character and world-information schemas"
}
