{
 "schema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sylvia-gm:content:ruleset-tests:1",
  "title": "Sylvia GM saved Ruleset scenarios, format 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
   "format": {
    "type": "integer",
    "const": 1
   },
   "scenarios": {
    "type": "array",
    "minItems": 1,
    "maxItems": 256,
    "items": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string",
       "minLength": 1
      },
      "description": {
       "type": "string",
       "minLength": 1
      },
      "covers": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "string",
        "minLength": 1
       },
       "uniqueItems": true
      },
      "initial_state": {
       "type": "array",
       "maxItems": 256,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "namespace": {
          "type": "string",
          "minLength": 1
         },
         "key": {
          "type": "string",
          "minLength": 1
         },
         "value": {}
        },
        "required": [
         "key",
         "value"
        ]
       }
      },
      "participants": {
       "type": "array",
       "maxItems": 256,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "id": {
          "type": "string",
          "minLength": 1
         },
         "kind": {
          "type": "string",
          "minLength": 1
         },
         "schema_id": {
          "type": "string",
          "minLength": 1
         },
         "data": {
          "type": "object",
          "additionalProperties": true
         }
        },
        "required": [
         "id",
         "kind",
         "schema_id",
         "data"
        ]
       }
      },
      "rolls": {
       "type": "array",
       "maxItems": 4096,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "sides": {
          "type": "integer",
          "minimum": 2
         },
         "value": {
          "type": "integer",
          "minimum": 1
         }
        },
        "required": [
         "sides",
         "value"
        ]
       }
      },
      "steps": {
       "type": "array",
       "minItems": 1,
       "maxItems": 256,
       "items": {
        "oneOf": [
         {
          "type": "object",
          "additionalProperties": false,
          "properties": {
           "kind": {
            "const": "player_action_response"
           },
           "automatic": {
            "type": "boolean"
           },
           "replies": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
             "oneOf": [
              {
               "type": "object",
               "additionalProperties": false,
               "properties": {
                "kind": {
                 "const": "tool"
                },
                "tool": {
                 "type": "string",
                 "minLength": 1
                },
                "arguments": {
                 "type": "object",
                 "additionalProperties": true
                },
                "expect_request": {
                 "type": "object",
                 "additionalProperties": false,
                 "properties": {
                  "decision_owner": {
                   "enum": [
                    "player",
                    "gm",
                    "none"
                   ]
                  },
                  "available_tools": {
                   "type": "array",
                   "items": {
                    "type": "string",
                    "minLength": 1
                   },
                   "uniqueItems": true
                  },
                  "unavailable_tools": {
                   "type": "array",
                   "items": {
                    "type": "string",
                    "minLength": 1
                   },
                   "uniqueItems": true
                  }
                 },
                 "required": []
                }
               },
               "required": [
                "kind",
                "tool",
                "arguments"
               ]
              },
              {
               "type": "object",
               "additionalProperties": false,
               "properties": {
                "kind": {
                 "const": "narration"
                },
                "text": {
                 "type": "string",
                 "minLength": 1
                },
                "expect_request": {
                 "type": "object",
                 "additionalProperties": false,
                 "properties": {
                  "decision_owner": {
                   "enum": [
                    "player",
                    "gm",
                    "none"
                   ]
                  },
                  "available_tools": {
                   "type": "array",
                   "items": {
                    "type": "string",
                    "minLength": 1
                   },
                   "uniqueItems": true
                  },
                  "unavailable_tools": {
                   "type": "array",
                   "items": {
                    "type": "string",
                    "minLength": 1
                   },
                   "uniqueItems": true
                  }
                 },
                 "required": []
                }
               },
               "required": [
                "kind",
                "text"
               ]
              }
             ]
            }
           },
           "expect": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
             "type": "object",
             "additionalProperties": false,
             "properties": {
              "subject": {
               "enum": [
                "state",
                "receipt",
                "control",
                "available_tools",
                "tool_results"
               ]
              },
              "path": {
               "type": "array",
               "maxItems": 32,
               "items": {
                "oneOf": [
                 {
                  "type": "string",
                  "minLength": 1
                 },
                 {
                  "type": "integer",
                  "minimum": 0
                 }
                ]
               }
              },
              "equals": {
               "description": "Exact expected JSON value, including false or null."
              }
             },
             "required": [
              "subject",
              "path",
              "equals"
             ]
            }
           }
          },
          "required": [
           "kind",
           "replies",
           "expect"
          ]
         },
         {
          "type": "object",
          "additionalProperties": false,
          "properties": {
           "kind": {
            "const": "gm_turn"
           },
           "message": {
            "type": "string",
            "minLength": 1
           },
           "replies": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
             "oneOf": [
              {
               "type": "object",
               "additionalProperties": false,
               "properties": {
                "kind": {
                 "const": "tool"
                },
                "tool": {
                 "type": "string",
                 "minLength": 1
                },
                "arguments": {
                 "type": "object",
                 "additionalProperties": true
                },
                "expect_request": {
                 "type": "object",
                 "additionalProperties": false,
                 "properties": {
                  "decision_owner": {
                   "enum": [
                    "player",
                    "gm",
                    "none"
                   ]
                  },
                  "available_tools": {
                   "type": "array",
                   "items": {
                    "type": "string",
                    "minLength": 1
                   },
                   "uniqueItems": true
                  },
                  "unavailable_tools": {
                   "type": "array",
                   "items": {
                    "type": "string",
                    "minLength": 1
                   },
                   "uniqueItems": true
                  }
                 },
                 "required": []
                }
               },
               "required": [
                "kind",
                "tool",
                "arguments"
               ]
              },
              {
               "type": "object",
               "additionalProperties": false,
               "properties": {
                "kind": {
                 "const": "narration"
                },
                "text": {
                 "type": "string",
                 "minLength": 1
                },
                "expect_request": {
                 "type": "object",
                 "additionalProperties": false,
                 "properties": {
                  "decision_owner": {
                   "enum": [
                    "player",
                    "gm",
                    "none"
                   ]
                  },
                  "available_tools": {
                   "type": "array",
                   "items": {
                    "type": "string",
                    "minLength": 1
                   },
                   "uniqueItems": true
                  },
                  "unavailable_tools": {
                   "type": "array",
                   "items": {
                    "type": "string",
                    "minLength": 1
                   },
                   "uniqueItems": true
                  }
                 },
                 "required": []
                }
               },
               "required": [
                "kind",
                "text"
               ]
              }
             ]
            }
           },
           "expect": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
             "type": "object",
             "additionalProperties": false,
             "properties": {
              "subject": {
               "enum": [
                "state",
                "receipt",
                "control",
                "available_tools",
                "tool_results"
               ]
              },
              "path": {
               "type": "array",
               "maxItems": 32,
               "items": {
                "oneOf": [
                 {
                  "type": "string",
                  "minLength": 1
                 },
                 {
                  "type": "integer",
                  "minimum": 0
