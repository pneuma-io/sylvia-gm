           "expect"
          ]
         },
         {
          "type": "object",
          "additionalProperties": false,
          "properties": {
           "kind": {
            "const": "assert"
           },
           "expect": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
             "type": "object",
             "additionalProperties": false,
             "properties": {
              "subject": {
               "enum": [
                "state",
                "receipt",
                "control",
                "available_tools",
                "tool_results"
               ]
              },
              "path": {
               "type": "array",
               "maxItems": 32,
               "items": {
                "oneOf": [
                 {
                  "type": "string",
                  "minLength": 1
                 },
                 {
                  "type": "integer",
                  "minimum": 0
                 }
                ]
               }
              },
              "equals": {
               "description": "Exact expected JSON value, including false or null."
              }
             },
             "required": [
              "subject",
              "path",
              "equals"
             ]
            }
           }
          },
          "required": [
           "kind",
           "expect"
          ]
         }
        ]
       }
      }
     },
     "required": [
      "id",
      "description",
      "covers",
      "initial_state",
      "participants",
      "rolls",
      "steps"
     ]
    }
   }
  },
  "required": [
   "format",
   "scenarios"
  ]
 },
 "example": {
  "format": 1,
  "scenarios": [
   {
    "id": "coin-heads",
    "description": "A controlled coin flip commits its result.",
    "covers": [
     "flip_coin"
    ],
    "initial_state": [],
    "participants": [],
    "rolls": [
     {
      "sides": 2,
      "value": 2
     }
    ],
    "steps": [
     {
      "kind": "gm_turn",
      "message": "Flip the coin.",
      "replies": [
       {
        "kind": "tool",
        "tool": "flip_coin",
        "arguments": {}
       },
       {
        "kind": "narration",
        "text": "The coin lands heads."
       }
      ],
      "expect": [
       {
        "subject": "receipt",
        "path": [
         "status"
        ],
        "equals": "committed"
       },
       {
        "subject": "receipt",
        "path": [
         "result",
         "context",
         "_result",
         "total"
        ],
        "equals": 2
       }
      ]
     }
    ]
   }
  ]
 },
 "notes": [
  "Scenario and initial-state identities must be unique. Rolls cannot exceed their die size.",
  "Setup data and action sources are validated by the ordinary campaign owners at execution.",
  "Omitted state namespaces refer to the tested Ruleset; participant hashes are derived.",
  "Tool names are canonical package tool names, not generated provider aliases.",
  "player_action_response replies to the preceding saved action without inventing player speech.",
  "Covers declares intent; only exercised actions and checked results establish coverage.",
  "Missing paths fail assertions. Unexpected requests or unconsumed scripted replies/rolls fail.",
  "Passing format validation alone does not run scenarios or establish readiness."
 ],
 "file": "tests/scenarios.json"
}
