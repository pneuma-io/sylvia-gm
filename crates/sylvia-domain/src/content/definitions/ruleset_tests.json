             "required": [
              "subject",
              "path",
              "equals"
             ]
            }
           }
          },
          "required": [
           "kind",
           "message",
           "replies",
           "expect"
          ]
         },
         {
          "type": "object",
          "additionalProperties": false,
          "properties": {
           "kind": {
            "const": "player_action"
           },
           "source": {
            "type": "object",
            "additionalProperties": true
           },
           "selection": {
            "type": "object",
            "additionalProperties": true
           },
           "confirmation": {
            "type": "string",
            "minLength": 1
           },
           "preview_only": {
            "type": "boolean"
           },
           "expect": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
             "type": "object",
             "additionalProperties": false,
             "properties": {
              "subject": {
               "enum": [
                "state",
                "receipt",
                "control",
                "available_tools",
                "tool_results"
               ]
              },
              "path": {
               "type": "array",
               "maxItems": 32,
               "items": {
                "oneOf": [
                 {
                  "type": "string",
                  "minLength": 1
                 },
                 {
                  "type": "integer",
                  "minimum": 0
