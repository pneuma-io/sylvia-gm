    "fields": [
     "sides",
     "count",
     "results",
     "total",
     "modifier"
    ],
    "total": "Sum of die faces only. The modifier is stored separately.",
    "effective_result": "Compute _roll.total + _roll.modifier when the rule adds a bonus.",
    "expression": "Use NdS (for example 1d2); supply a flat bonus through modifier.",
    "reporting_example": [
     {
      "dice": {
       "expression": "1d2",
       "modifier": "1"
      },
      "store_as": "_roll"
     },
     {
      "set": {
       "field": "_result",
       "value": "_roll.total + _roll.modifier"
      }
     }
    ],
    "test_example": "For the example above, a controlled face of 2 produces scalar _result = 3. Assert receipt.result.context._result, not the raw _roll.total. There is no modified_total field. A missing-path failure identifies an assertion error, not proof of an arithmetic defect."
   }
