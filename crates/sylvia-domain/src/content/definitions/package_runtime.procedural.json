  "valid_example": {
   "tools": {
    "resolve_signal": {
     "description": "Resolve a signal check.",
     "parameters": [
      {
       "name": "difficulty",
       "type": "integer",
       "minimum": 1,
       "required": true
      }
     ],
     "pre_conditions": [
      {
       "condition": "state.ready == true",
       "error": "The signal is unavailable."
      }
     ],
     "effects": [
      {
       "dice": {
        "expression": "d20"
       },
       "store_as": "_roll"
      },
      {
       "condition": "_roll.total >= difficulty",
       "on_true": [
        {
         "set": {
          "field": "state.success",
          "value": true
         }
        }
       ]
      }
     ],
     "metadata": {
      "category": "signal",
      "model_behavior": "optional"
     }
    }
   },
   "procedures": {},
   "definitions": {},
   "definition_row_schemas": {},
   "narrative": {}
