        }
       },
       "additionalProperties": false
      }
     },
     "schema_extensions": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "extension_name",
        "extension_sha256",
        "predecessor_migration_name",
        "predecessor_sql_sha256"
       ],
       "properties": {
        "extension_name": {
         "type": "string",
         "minLength": 1
        },
        "extension_sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        },
        "predecessor_migration_name": {
         "type": "string",
         "minLength": 1
        },
        "predecessor_sql_sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        }
       },
       "additionalProperties": false
      }
     }
    },
    "additionalProperties": false
   },
