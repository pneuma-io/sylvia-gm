{
 "schema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sylvia-gm:content:spatial-scene:1",
  "title": "Sylvia GM spatial scene v1",
  "description": "Ruleset-owned, Ruleset-neutral map geometry and spatial state. The shared spatial engine interprets coordinates, obstruction and visibility; the Ruleset owns their gameplay meaning and consequences.",
  "type": "object",
  "additionalProperties": false,
  "required": [
   "format",
   "map",
   "geometry",
   "entities",
   "zones",
   "terrain"
  ],
  "properties": {
   "format": {
    "type": "integer",
    "const": 1
   },
   "map": {
    "$ref": "#/$defs/map"
   },
   "geometry": {
    "type": "array",
    "maxItems": 20000,
    "items": {
     "$ref": "#/$defs/geometry"
    }
   },
   "entities": {
    "type": "array",
    "maxItems": 5000,
    "items": {
     "$ref": "#/$defs/entity"
    }
   },
   "zones": {
    "type": "array",
    "maxItems": 5000,
    "items": {
     "$ref": "#/$defs/zone"
    }
   },
   "terrain": {
    "type": "array",
    "maxItems": 100000,
    "items": {
     "$ref": "#/$defs/terrain"
    }
   }
  },
  "$defs": {
   "identity": {
    "type": "string",
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$(?![\\s\\S])"
   },
   "number": {
    "type": "number",
    "minimum": -1000000,
    "maximum": 1000000
   },
   "positiveNumber": {
    "type": "number",
    "exclusiveMinimum": 0,
    "maximum": 1000000
   },
   "coordinate2": {
    "type": "array",
    "minItems": 2,
    "maxItems": 2,
    "items": {
     "$ref": "#/$defs/number"
    }
   },
   "coordinate3": {
    "type": "array",
    "minItems": 3,
    "maxItems": 3,
    "items": {
     "$ref": "#/$defs/number"
    }
   },
   "cell": {
    "type": "array",
    "minItems": 2,
    "maxItems": 2,
    "items": {
     "type": "integer",
     "minimum": 0,
     "maximum": 2047
    }
   },
   "bounds": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "min",
     "max"
    ],
    "properties": {
     "min": {
      "$ref": "#/$defs/coordinate3"
     },
     "max": {
      "$ref": "#/$defs/coordinate3"
     }
    }
   },
   "grid": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "cell_size",
     "unit",
     "origin"
    ],
    "properties": {
     "cell_size": {
      "$ref": "#/$defs/positiveNumber"
     },
     "unit": {
      "$ref": "#/$defs/identity"
     },
     "origin": {
      "$ref": "#/$defs/coordinate2"
     }
    }
   },
   "layer": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "min_elevation",
     "max_elevation"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/identity"
     },
     "min_elevation": {
      "$ref": "#/$defs/number"
     },
     "max_elevation": {
      "$ref": "#/$defs/number"
     }
    }
   },
   "map": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "revision",
     "bounds",
     "grid",
     "layers"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/identity"
     },
     "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
     },
     "bounds": {
      "$ref": "#/$defs/bounds"
     },
     "grid": {
      "$ref": "#/$defs/grid"
     },
     "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
       "$ref": "#/$defs/layer"
      }
     }
    }
   },
   "movement": {
    "type": "string",
    "enum": [
     "passable",
     "blocking"
    ]
   },
   "visibility": {
    "type": "string",
    "enum": [
     "clear",
     "opaque"
    ]
   },
   "box": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "min",
     "max"
    ],
    "properties": {
     "kind": {
      "const": "box"
     },
     "min": {
      "$ref": "#/$defs/coordinate3"
     },
     "max": {
      "$ref": "#/$defs/coordinate3"
     }
    }
   },
   "cylinder": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "center",
     "radius",
     "height"
    ],
    "properties": {
     "kind": {
      "const": "cylinder"
     },
     "center": {
      "$ref": "#/$defs/coordinate3"
     },
     "radius": {
      "$ref": "#/$defs/positiveNumber"
     },
     "height": {
      "$ref": "#/$defs/positiveNumber"
     }
    }
   },
   "shape": {
    "oneOf": [
     {
      "$ref": "#/$defs/box"
     },
     {
      "$ref": "#/$defs/cylinder"
     }
    ]
   },
   "metadata": {
    "type": "object",
    "description": "The map's declared extension area. Rulesets may store finite JSON here. Player projection reads only a closed metadata.player presentation record."
   },
   "destroyed": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "active",
     "movement",
     "visibility"
    ],
    "properties": {
     "active": {
      "type": "boolean"
     },
     "movement": {
      "$ref": "#/$defs/movement"
     },
     "visibility": {
      "$ref": "#/$defs/visibility"
     }
    }
   },
   "geometry": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "map_id",
     "volume",
     "active",
     "movement",
     "visibility",
     "metadata",
     "destroyed"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/identity"
     },
     "map_id": {
      "$ref": "#/$defs/identity"
     },
     "volume": {
      "$ref": "#/$defs/box"
     },
     "active": {
      "type": "boolean"
     },
     "movement": {
      "$ref": "#/$defs/movement"
     },
     "occupies_cells": {
      "type": "boolean",
      "default": true,
      "description": "Omission is admitted as true for older scenes."
     },
     "visibility": {
      "$ref": "#/$defs/visibility"
     },
     "metadata": {
      "$ref": "#/$defs/metadata"
     },
     "destroyed": {
      "$ref": "#/$defs/destroyed"
     }
    }
   },
   "boxFootprint": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "half_extents"
    ],
    "properties": {
     "kind": {
      "const": "box"
     },
     "half_extents": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
       "$ref": "#/$defs/positiveNumber"
      }
     }
    }
   },
   "circleFootprint": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "radius"
    ],
    "properties": {
     "kind": {
      "const": "circle"
     },
     "radius": {
      "$ref": "#/$defs/positiveNumber"
     }
    }
   },
   "entity": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "map_id",
     "position",
     "footprint",
     "height",
     "facing",
     "active",
     "movement",
     "visibility",
     "metadata"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/identity"
     },
     "map_id": {
      "$ref": "#/$defs/identity"
     },
     "position": {
      "$ref": "#/$defs/coordinate3"
     },
     "footprint": {
      "oneOf": [
       {
        "$ref": "#/$defs/boxFootprint"
       },
       {
        "$ref": "#/$defs/circleFootprint"
       }
      ]
     },
     "height": {
      "$ref": "#/$defs/positiveNumber"
     },
     "facing": {
      "$ref": "#/$defs/coordinate2"
     },
     "active": {
      "type": "boolean"
     },
     "movement": {
      "$ref": "#/$defs/movement"
     },
     "visibility": {
      "$ref": "#/$defs/visibility"
     },
     "metadata": {
      "$ref": "#/$defs/metadata"
     }
    }
   },
   "zone": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "map_id",
     "shape",
     "metadata"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/identity"
     },
     "map_id": {
      "$ref": "#/$defs/identity"
     },
     "shape": {
      "$ref": "#/$defs/shape"
     },
     "metadata": {
      "$ref": "#/$defs/metadata"
     }
    }
   },
   "terrain": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "cell",
     "layer_id",
     "cost"
    ],
    "properties": {
     "cell": {
      "$ref": "#/$defs/cell"
     },
     "layer_id": {
      "$ref": "#/$defs/identity"
     },
     "cost": {
      "$ref": "#/$defs/positiveNumber"
     }
    }
   }
  }
 },
 "example": {
  "format": 1,
  "map": {
   "id": "relay-floor",
   "revision": 1,
   "bounds": {
    "min": [
     0,
     0,
     0
    ],
    "max": [
     8,
     6,
     3
    ]
   },
   "grid": {
    "cell_size": 1,
    "unit": "m",
    "origin": [
     0,
     0
    ]
   },
   "layers": [
    {
     "id": "floor",
     "min_elevation": 0,
     "max_elevation": 3
    }
   ]
  },
  "geometry": [
   {
    "id": "bulkhead",
    "map_id": "relay-floor",
    "volume": {
     "kind": "box",
     "min": [
      3,
      2,
      0
     ],
     "max": [
      3.25,
      4,
      2.5
     ]
    },
    "active": true,
    "movement": "blocking",
    "occupies_cells": true,
    "visibility": "opaque",
    "metadata": {
     "player": {
      "label": "Bulkhead",
      "kind": "door"
     }
    },
    "destroyed": {
     "active": false,
     "movement": "passable",
     "visibility": "clear"
    }
   }
  ],
  "entities": [
   {
    "id": "keeper",
    "map_id": "relay-floor",
    "position": [
     1.5,
     2.5,
     0
    ],
    "footprint": {
     "kind": "circle",
     "radius": 0.4
    },
    "height": 1.8,
    "facing": [
     1,
     0
    ],
    "active": true,
    "movement": "blocking",
    "visibility": "opaque",
    "metadata": {
     "player": {
      "label": "Keeper",
      "kind": "unit"
     }
    }
   }
  ],
  "zones": [],
  "terrain": [
   {
    "cell": [
     2,
     2
    ],
    "layer_id": "floor",
    "cost": 2
   }
  ]
 },
 "notes": [
  "All objects except metadata are closed. metadata is the deliberate Ruleset extension area and is limited to 16 KiB of finite canonical JSON per record.",
  "The complete scene is limited to 24 JSON levels and 100,000 JSON nodes. Coordinates are finite and have an absolute limit of 1,000,000.",
  "Every bounds minimum must be less than its corresponding maximum. Grid origin equals the lower x/y bounds. Each axis has at most 2,048 cells and the grid has at most 4,000,000 cells in total.",
  "Layer IDs are unique and their elevation ranges are positive and inside map bounds. Geometry, entity and zone IDs are unique across all three collections, and every map_id equals map.id.",
  "Volumes, entity footprints and zone shapes must have positive extents and fit inside map bounds. Entity facing must be nonzero. Terrain cells must fit the grid, name a declared layer and be unique per layer.",
  "Player map projection exposes an item only when metadata.player is a valid closed display record. That record requires label and kind; it may contain state, stance, side, color, icon, interactive and height_label. Hidden metadata stays owner-only.",
  "Tactical objectives, selection and preview belong to the tactical-grid surface source, outside this scene object. The renderer filters and bounds them. Selections are revalidated against the current projection and authoritative scene."
 ],
 "file": "Ruleset state: spatial scene"
}
