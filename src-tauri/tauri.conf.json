{
  "productName": "Sylvia GM",
  "version": "0.3.0-alpha.1",
  "identifier": "com.pneuma-io.sylvia-gm",
  "build": {
    "frontendDist": "frontend",
    "beforeDevCommand": "",
    "beforeBuildCommand": "uv run --locked --all-extras python src-tauri/scripts/build_owner_sidecar.py"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../rulesets/srd-lite/ATTRIBUTION.md": "licenses/SRD-5.2.1.md",
      "../campaign-settings/severed-lands/ATTRIBUTION.md": "licenses/Severed-Lands.md",
      "../COPYRIGHT": "licenses/COPYRIGHT",
      "../LICENSING-STATUS.md": "licenses/LICENSING-STATUS.md",
      "../SYLVIA-ADDITIONAL-PERMISSIONS.md": "licenses/SYLVIA-ADDITIONAL-PERMISSIONS.md",
      "../licenses/MIT-PREVIOUS-GRANT.txt": "licenses/MIT-PREVIOUS-GRANT.txt",
      "../dependency-notices.txt": "licenses/dependency-notices.txt",
      "../licenses/DEPENDENCY-NOTICES-STATUS.md": "licenses/DEPENDENCY-NOTICES-STATUS.md",
      "../licenses/RUST-STDLIB-COPYRIGHT": "licenses/RUST-STDLIB-COPYRIGHT",
      "../licenses/RUST-STDLIB-COPYRIGHT-library.html": "licenses/RUST-STDLIB-COPYRIGHT-library.html",
      "../licenses/RUST-STDLIB-LICENSE-APACHE": "licenses/RUST-STDLIB-LICENSE-APACHE",
      "../licenses/RUST-STDLIB-LICENSE-MIT": "licenses/RUST-STDLIB-LICENSE-MIT",
      "../licenses/COVERED-SOURCE.zip": "licenses/COVERED-SOURCE.zip",
      "../licenses/COVERED-SOURCE-MAP.json": "licenses/COVERED-SOURCE-MAP.json",
      "../licenses/COVERED-SOURCE-README.md": "licenses/COVERED-SOURCE-README.md",
      "../licenses/dictation/README.md": "licenses/dictation/README.md",
      "../licenses/dictation/HERMES-MIT.txt": "licenses/dictation/HERMES-MIT.txt",
      "../licenses/dictation/FASTER-WHISPER-MIT.txt": "licenses/dictation/FASTER-WHISPER-MIT.txt",
      "../licenses/dictation/WHISPER-MIT.txt": "licenses/dictation/WHISPER-MIT.txt",
      "../licenses/dictation/CTRANSLATE2-MIT.txt": "licenses/dictation/CTRANSLATE2-MIT.txt",
      "../licenses/dictation/FFMPEG-LGPLv3.txt": "licenses/dictation/FFMPEG-LGPLv3.txt",
      "../licenses/dictation/GPLv3.txt": "licenses/dictation/GPLv3.txt",
      "../licenses/dictation/PORTAUDIO-MIT.txt": "licenses/dictation/PORTAUDIO-MIT.txt"
    },
    "externalBin": [
      "binaries/sylvia-gm-owner"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
