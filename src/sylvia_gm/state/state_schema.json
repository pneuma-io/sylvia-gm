{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pneuma-io.github.io/sylvia-gm/schemas/state-schema-v0.2.0.json",
  "title": "Sylvia GM State Schema",
  "description": "Legacy JSON state shape used by inherited state helpers. It is not the campaign authority or a default ruleset; authoritative mutable state belongs to the owner-managed campaign aggregate.",
  "type": "object",
  "required": ["campaign", "party", "characters", "npcs", "monsters", "combat", "combat_history", "quests", "world", "metadata"],
  "properties": {
    "$schema": {"type": "string", "description": "Reference to the schema file itself"},
    "campaign": {"$ref": "#/$defs/campaign"},
    "party": {"$ref": "#/$defs/party"},
    "characters": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/character"}
    },
    "npcs": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/npc"}
    },
    "monsters": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/monster"}
    },
    "combat": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/combat"}
      ]
    },
    "combat_history": {
      "type": "array",
      "items": {"$ref": "#/$defs/combat_history_entry"}
    },
    "quests": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/quest"}
    },
    "world": {"$ref": "#/$defs/world"},
    "metadata": {"$ref": "#/$defs/metadata"}
  },
  "$defs": {
    "campaign": {
      "type": "object",
      "required": ["id", "name", "ruleset", "created_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "ruleset": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "session_count": {"type": "integer", "minimum": 0, "default": 0},
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "status"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
              "title": {"type": "string", "minLength": 1, "maxLength": 120},
              "summary": {"type": "string", "default": "", "maxLength": 500},
              "key_notes": {
                "type": "array",
                "items": {"type": "string", "maxLength": 200},
                "default": [],
                "maxItems": 10
              },
              "message_count": {"type": "integer", "minimum": 0, "default": 0},
              "compressed_at": {"type": ["string", "null"], "format": "date-time", "default": null},
              "status": {"type": "string", "enum": ["active", "compressed"], "default": "active"}
            }
          },
          "default": []
        }
      }
    },
    "character": {
      "type": "object",
      "required": ["id", "name", "kind", "species", "archetype", "hp", "max_hp", "ac", "abilities"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 50},
        "kind": {"type": "string", "enum": ["pc", "npc"]},
        "species": {"type": "string", "minLength": 1},
        "archetype": {"type": "string", "minLength": 1},
        "level": {
          "oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]
        },
        "xp": {
          "oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]
        },
        "hp": {"type": "integer", "minimum": 0},
        "max_hp": {"type": "integer", "minimum": 1},
        "temp_hp": {"type": "integer", "minimum": 0, "default": 0},
        "ac": {"type": "integer", "minimum": 0},
        "initiative": {
          "oneOf": [{"type": "integer"}, {"type": "null"}]
        },
        "conditions": {
          "type": "array",
          "items": {"type": "string"},
          "default": []
        },
        "death_saves": {
          "oneOf": [
            {"$ref": "#/$defs/death_saves"},
            {"type": "null"}
          ]
        },
        "resources": {"$ref": "#/$defs/resources"},
        "reaction_used": {"type": "boolean", "default": false},
        "inventory": {
          "type": "array",
          "items": {"$ref": "#/$defs/inventory_item"},
          "default": []
        },
        "equipment": {"$ref": "#/$defs/equipment"},
        "spells_known": {
          "type": "array",
          "items": {"$ref": "#/$defs/spell"},
          "default": []
        },
        "romance": {
          "oneOf": [
            {"$ref": "#/$defs/romance"},
            {"type": "null"}
          ]
        },
        "abilities": {"$ref": "#/$defs/abilities"},
        "skills": {
          "oneOf": [
            {"type": "object"},
            {"type": "null"}
          ]
        },
        "proficiency_bonus": {
          "oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]
        },
        "speed": {"type": "integer", "minimum": 0, "default": 30},
        "is_alive": {"type": "boolean", "default": true},
        "notes": {
          "type": "array",
          "items": {"type": "string"},
          "maxItems": 20,
          "default": []
        },
        "combat_control": {
          "type": "string",
          "enum": ["user", "dm"],
          "default": "dm",
          "description": "Who controls this character in combat. 'dm' means the AI chooses actions; 'user' means the player is prompted."
        }
      }
    },
    "npc": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
        "name": {"type": "string", "minLength": 1},
        "location": {"type": ["string", "null"], "default": null},
        "role": {"type": ["string", "null"], "default": null},
        "faction": {"type": ["string", "null"], "default": null},
        "attitude": {
          "type": "string",
          "enum": ["hostile", "neutral", "friendly", "allied"],
          "default": "neutral"
        },
        "alive": {"type": "boolean", "default": true},
        "relationship": {"type": "integer", "minimum": -10, "maximum": 10, "default": 0},
        "knowledge": {
          "type": "object",
          "default": {}
        },
        "stat_block": {
          "oneOf": [{"type": "object"}, {"type": "null"}]
        },
        "notes": {
          "type": "array",
          "items": {"type": "string"},
          "maxItems": 20,
          "default": []
        }
      }
    },
    "monster": {
      "type": "object",
      "required": ["id", "name", "size", "type", "hp", "max_hp", "ac", "abilities"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
        "name": {"type": "string", "minLength": 1},
        "size": {
          "type": "string",
          "enum": ["tiny", "small", "medium", "large", "huge", "gargantuan"]
        },
        "type": {"type": "string", "minLength": 1},
        "hp": {"type": "integer", "minimum": 0},
        "max_hp": {"type": "integer", "minimum": 1},
        "temp_hp": {"type": "integer", "minimum": 0, "default": 0},
        "ac": {"type": "integer", "minimum": 0},
        "initiative": {
          "oneOf": [{"type": "integer"}, {"type": "null"}]
        },
        "conditions": {
          "type": "array",
          "items": {"type": "string"},
          "default": []
        },
        "abilities": {"$ref": "#/$defs/abilities"},
        "skills": {
          "oneOf": [{"type": "object"}, {"type": "null"}]
        },
        "speed": {"type": "integer", "minimum": 0, "default": 30},
        "is_alive": {"type": "boolean", "default": true},
        "cr": {
          "oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]
        }
      }
    },
    "abilities": {
      "type": "object",
      "properties": {
        "str": {
          "oneOf": [
            {"type": "object", "required": ["score"], "properties": {"score": {"type": "integer"}, "modifier": {"type": ["integer", "null"]}}},
            {"type": "null"}
          ]
        },
        "dex": {
          "oneOf": [
            {"type": "object", "required": ["score"], "properties": {"score": {"type": "integer"}, "modifier": {"type": ["integer", "null"]}}},
            {"type": "null"}
          ]
        },
        "con": {
          "oneOf": [
            {"type": "object", "required": ["score"], "properties": {"score": {"type": "integer"}, "modifier": {"type": ["integer", "null"]}}},
            {"type": "null"}
          ]
        },
        "int": {
          "oneOf": [
            {"type": "object", "required": ["score"], "properties": {"score": {"type": "integer"}, "modifier": {"type": ["integer", "null"]}}},
            {"type": "null"}
          ]
        },
        "wis": {
          "oneOf": [
            {"type": "object", "required": ["score"], "properties": {"score": {"type": "integer"}, "modifier": {"type": ["integer", "null"]}}},
            {"type": "null"}
          ]
        },
        "cha": {
          "oneOf": [
            {"type": "object", "required": ["score"], "properties": {"score": {"type": "integer"}, "modifier": {"type": ["integer", "null"]}}},
            {"type": "null"}
          ]
        },
        "wil": {
          "oneOf": [
            {"type": "object", "required": ["score"], "properties": {"score": {"type": "integer"}, "modifier": {"type": ["integer", "null"]}}},
            {"type": "null"}
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "spell_slots": {
          "oneOf": [{"type": "object"}, {"type": "null"}]
        },
        "ki_points": {
          "oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]
        },
        "hit_dice": {
          "oneOf": [{"type": "object"}, {"type": "null"}]
        },
        "channel_divinity": {
          "oneOf": [{"type": "boolean"}, {"type": "null"}]
        },
        "rage_uses": {
          "oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]
        },
        "bardic_inspiration": {
          "oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]
        },
        "sorcery_points": {
          "oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]
        }
      }
    },
    "equipment": {
      "type": "object",
      "properties": {
        "main_hand": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "off_hand": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "armor": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "head": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "neck": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "ring_1": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "ring_2": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "cloak": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "boots": {"oneOf": [{"type": "string"}, {"type": "null"}]}
      }
    },
    "inventory_item": {
      "type": "object",
      "required": ["name", "quantity"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "quantity": {"type": "integer", "minimum": 1},
        "location": {"type": "string"},
        "attuned_to": {"type": "string"},
        "description": {"type": "string"},
        "weight": {"type": "number", "minimum": 0},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "spell": {
      "type": "object",
      "required": ["name", "level"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "level": {"type": "integer", "minimum": 0, "maximum": 9},
        "school": {"type": "string"},
        "prepared": {"type": "boolean", "default": false},
        "description": {"type": "string"}
      }
    },
    "death_saves": {
      "type": "object",
      "required": ["successes", "failures"],
      "properties": {
        "successes": {"type": "integer", "minimum": 0, "maximum": 3},
        "failures": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "romance": {
      "type": "object",
      "properties": {
        "partner_id": {"type": "string"},
        "status": {"type": "string"},
        "affinity": {"type": "integer", "minimum": -10, "maximum": 10},
        "history": {
          "type": "array",
          "items": {"type": "object"}
        }
      }
    },
    "combat": {
      "type": "object",
      "required": ["round", "turn_index", "order", "participants", "location", "status", "started_at"],
      "properties": {
        "active": {"type": "boolean"},
        "round": {"type": "integer", "minimum": 1},
        "turn_index": {"type": "integer", "minimum": 0},
        "order": {
          "type": "array",
          "items": {"type": "string"}
        },
        "participants": {
          "type": "array",
          "items": {"type": "string"}
        },
        "location": {"type": "string", "minLength": 1},
        "log": {
          "type": "array",
          "items": {"type": "string"},
          "default": []
        },
        "started_at": {"type": "string", "format": "date-time"},
        "status": {
          "type": "string",
          "enum": ["active", "victory", "defeat", "fled"],
          "default": "active"
        },
        "positions": {
          "type": "object",
          "description": "Entity positions keyed by entity ID. Each value has band (close/near/far/distant) and optional x,y grid coords.",
          "additionalProperties": {
            "type": "object",
            "required": ["band"],
            "properties": {
              "band": {
                "type": "string",
                "enum": ["close", "near", "far", "distant"]
              },
              "x": {
                "oneOf": [{"type": "integer"}, {"type": "null"}]
              },
              "y": {
                "oneOf": [{"type": "integer"}, {"type": "null"}]
              }
            }
          }
        }
      }
    },
    "combat_history_entry": {
      "type": "object",
      "required": ["timestamp", "participants", "rounds", "outcome", "location"],
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "participants": {"type": "array", "items": {"type": "string"}},
        "rounds": {"type": "integer", "minimum": 1},
        "outcome": {"type": "string", "enum": ["victory", "defeat", "fled"]},
        "location": {"type": "string"},
        "log_summary": {"type": "string"}
      }
    },
    "party": {
      "type": "object",
      "required": ["gold", "members"],
      "properties": {
        "gold": {"type": "integer", "minimum": 0},
        "members": {
          "type": "array",
          "items": {"type": "string"}
        },
        "shared_inventory": {
          "type": "array",
          "items": {"$ref": "#/$defs/inventory_item"}
        },
        "reputation": {
          "type": "object",
          "default": {}
        },
        "world_flags": {
          "type": "array",
          "items": {"type": "string", "maxLength": 200},
          "default": []
        }
      }
    },
    "quest": {
      "type": "object",
      "required": ["id", "name", "status", "stages"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "status": {
          "type": "string",
          "enum": ["available", "active", "completed", "failed"]
        },
        "stage": {"type": "integer", "minimum": 0, "default": 0},
        "stages": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description", "complete"],
            "properties": {
              "description": {"type": "string", "minLength": 1},
              "complete": {"type": "boolean", "default": false}
            }
          },
          "default": []
        },
        "giver": {"type": ["string", "null"], "default": null},
        "rewards": {
          "type": "object",
          "properties": {
            "gold": {"type": ["integer", "null"]},
            "items": {"type": ["array", "null"]},
            "xp": {"type": ["integer", "null"]}
          },
          "default": {}
        },
        "started_at": {"type": ["string", "null"], "format": "date-time", "default": null},
        "completed_at": {"type": ["string", "null"], "format": "date-time", "default": null}
      }
    },
    "world": {
      "type": "object",
      "required": [],
      "properties": {
        "current_scene": {"type": ["string", "null"], "default": null},
        "current_location": {"type": ["string", "null"], "default": null},
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["timestamp", "event"],
            "properties": {
              "timestamp": {"type": "string", "format": "date-time"},
              "event": {"type": "string", "minLength": 1},
              "category": {"type": "string", "default": "meta"}
            }
          },
          "default": []
        },
        "flags": {
          "type": "object",
          "default": {}
        },
        "time_of_day": {
          "type": "string",
          "enum": ["morning", "afternoon", "evening", "night", "midnight", "dawn"],
          "default": "morning"
        },
        "day": {"type": "integer", "minimum": 1, "default": 1},
        "weather": {"type": ["string", "null"], "default": null}
      }
    },
    "metadata": {
      "type": "object",
      "required": ["version", "last_modified", "changelog_entries", "schema_version"],
      "properties": {
        "version": {"type": "string"},
        "last_modified": {"type": "string", "format": "date-time"},
        "changelog_entries": {"type": "integer", "minimum": 0},
        "schema_version": {"type": "string"}
      }
    }
  }
}
