{"nodes":[{"id":"title","type":"text","x":-60,"y":-300,"width":780,"height":180,"text":"# BULWARK\nThree specialties: mobile COVER, an established STRONGPOINT, and active ally protection. No separate HUNKER action/state exists.","color":"2"},{"id":"back","type":"file","x":-60,"y":-70,"width":360,"height":130,"file":"Maps/Classes.canvas","color":"6"},{"id":"bulwark","type":"file","x":420,"y":-80,"width":440,"height":160,"file":"Classes/BULWARK.md","color":"2"},{"id":"g-spec","type":"group","x":-100,"y":200,"width":2750,"height":720,"label":"LOCKED SPECIALTIES — TERTIARY TREES","color":"2"},{"id":"shield","type":"file","x":100,"y":370,"width":620,"height":260,"file":"Specialties/SHIELD BEARER.md","color":"5"},{"id":"anchor","type":"file","x":950,"y":370,"width":620,"height":260,"file":"Specialties/ANCHOR.md","color":"2"},{"id":"guardian","type":"file","x":1800,"y":370,"width":620,"height":260,"file":"Specialties/GUARDIAN.md","color":"3"},{"id":"cover","type":"file","x":100,"y":740,"width":420,"height":170,"file":"Combat/COVER.md","color":"5"},{"id":"prep","type":"file","x":1050,"y":740,"width":420,"height":170,"file":"Combat/PREP ACTION.md","color":"2"},{"id":"res","type":"file","x":1900,"y":740,"width":420,"height":170,"file":"Combat/RES.md","color":"3"}],"edges":[{"id":"b-shield","fromNode":"bulwark","fromSide":"bottom","toNode":"shield","toSide":"top","toEnd":"arrow"},{"id":"b-anchor","fromNode":"bulwark","fromSide":"bottom","toNode":"anchor","toSide":"top","toEnd":"arrow"},{"id":"b-guardian","fromNode":"bulwark","fromSide":"bottom","toNode":"guardian","toSide":"top","toEnd":"arrow"},{"id":"shield-cover","fromNode":"shield","fromSide":"bottom","toNode":"cover","toSide":"top","toEnd":"arrow"},{"id":"anchor-prep","fromNode":"anchor","fromSide":"bottom","toNode":"prep","toSide":"top","toEnd":"arrow"},{"id":"guardian-res","fromNode":"guardian","fromSide":"bottom","toNode":"res","toSide":"top","toEnd":"arrow"}]}