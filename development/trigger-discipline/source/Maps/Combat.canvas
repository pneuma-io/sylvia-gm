{"nodes":[{"id":"title","type":"text","x":-60,"y":-310,"width":800,"height":190,"text":"# COMBAT\nTEAM TURNS and AP create the time structure. GRID position, COVER, preparation, and exposure create the tactical structure. Attacks flow through HIT QUALITY into PROJECTILE routing before target PEN / RES / HP; critical medical states come from injury-specific LIFE-THREATENING CONDITIONS.","color":"1"},{"id":"back","type":"file","x":-60,"y":-80,"width":340,"height":130,"file":"Trigger Discipline.canvas","color":"6"},{"id":"hub","type":"file","x":390,"y":-80,"width":340,"height":130,"file":"Hubs/Combat.md","color":"1"},{"id":"g-time","type":"group","x":-100,"y":180,"width":1600,"height":620,"label":"TURN & TIME","color":"1"},{"id":"g-pos","type":"group","x":1600,"y":180,"width":2050,"height":980,"label":"GRID, POSITION & CONTROL","color":"5"},{"id":"g-attack","type":"group","x":-100,"y":900,"width":1600,"height":850,"label":"ATTACK PIPELINE","color":"2"},{"id":"g-life","type":"group","x":1600,"y":1260,"width":2050,"height":820,"label":"SURVIVABILITY & CRITICAL CARE","color":"3"},{"id":"g-maps","type":"group","x":3750,"y":180,"width":1150,"height":1730,"label":"DEDICATED MAPS","color":"6"},{"id":"ambush","type":"file","x":100,"y":350,"width":310,"height":150,"file":"Combat/AMBUSH.md","color":"1"},{"id":"initiative","type":"file","x":520,"y":350,"width":330,"height":150,"file":"Combat/TEAM INITIATIVE.md","color":"1"},{"id":"turn","type":"file","x":960,"y":350,"width":310,"height":150,"file":"Combat/TEAM TURN.md","color":"1"},{"id":"ap","type":"file","x":960,"y":580,"width":310,"height":150,"file":"Combat/AP.md","color":"1"},{"id":"grid","type":"file","x":1770,"y":300,"width":340,"height":160,"file":"Combat/GRID.md","color":"5"},{"id":"movement","type":"file","x":1770,"y":540,"width":340,"height":160,"file":"Combat/MOVEMENT.md","color":"5"},{"id":"casualty-movement","type":"file","x":1770,"y":1040,"width":340,"height":160,"file":"Combat/CASUALTY MOVEMENT.md","color":"3"},{"