","toNode":"lifecond","toSide":"left","toEnd":"arrow"},{"id":"downed-life","fromNode":"downed","fromSide":"bottom","toNode":"lifecond","toSide":"top","toEnd":"arrow","label":"if injury is life-threatening"},{"id":"life-door","fromNode":"lifecond","fromSide":"right","toNode":"door","toSide":"left","toEnd":"arrow","label":"ACTIVE / FAILED while DOWNED"},{"id":"life-stabilize","fromNode":"lifecond","fromSide":"right","toNode":"stabilize","toSide":"left","toEnd":"arrow","label":"ACTIVE"},{"id":"life-resuscitation","fromNode":"lifecond","fromSide":"right","toNode":"resuscitation","toSide":"left","toEnd":"arrow","label":"reversible FAILED"}]}
