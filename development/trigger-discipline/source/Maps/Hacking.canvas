{"nodes":[{"id":"title","type":"text","x":-60,"y":-350,"width":950,"height":220,"text":"# HACKER\nThe HACKER class subverts systems. NETWORKER traverses connected topology; LOCAL HACKER attacks one directly accessible NODE more deeply. Security is architecture and state, not cyber HP.","color":"4"},{"id":"back","type":"file","x":-60,"y":-80,"width":360,"height":130,"file":"Maps/Technology.canvas","color":"6"},{"id":"class","type":"file","x":410,"y":-80,"width":400,"height":140,"file":"Classes/HACKER.md","color":"4"},{"id":"hub","type":"file","x":930,"y":-80,"width":360,"height":130,"file":"Hubs/Hacking.md","color":"4"},{"id":"g-top","type":"group","x":-100,"y":180,"width":2100,"height":850,"label":"NETWORK TOPOLOGY","color":"4"},{"id":"g-access","type":"group","x":2100,"y":180,"width":1800,"height":850,"label":"ACCESS & DEFENSE","color":"3"},{"id":"g-net","type":"group","x":-100,"y":1120,"width":2100,"height":1100,"label":"NETWORKER","color":"4"},{"id":"g-local","type":"group","x":2100,"y":1120,"width":2100,"height":1100,"label":"LOCAL HACKER","color":"5"},{"id":"network","type":"file","x":100,"y":380,"width":320,"height":150,"file":"Hacking/NETWORK.md","color":"4"},{"id":"node","type":"file","x":520,"y":380,"width":320,"height":150,"file":"Hacking/NODE.md","color":"4"},{"id":"link","type":"file","x":940,"y":380,"width":320,"height":150,"file":"Hacking/LINK.md","color":"4"},{"id":"segment","type":"file","x":1360,"y":380,"width":360,"height":150,"file":"Hacking/NETWORK SEGMENT.md","color":"4"},{"id":"gateway","type":"file","x":1360,"y":650,"width":360,"height":150,"file":"Hacking/GATEWAY.md","color":"4"},{"id":"auth","type":"file","x":2280,"y":350,"width":350,"height":150,"file":"Hacking/AUTHENTICATION.md","color":"3"},{"id":"intrusion","type":"file","x":2280,"y":890,"width":350,"height":150,"file":"Hacking/INTRUSION.md","color":"3"},{"id":"cred","type":"file","x":2750,"y":350,"width":350,"height":150,"file":"Hacking/CREDENTIAL.md","color":"3"},{"id":"priv","type":"f