{"nodes":[{"id":"title","type":"text","x":-60,"y":-320,"width":1050,"height":220,"text":"# COMBAT CLASSES\nFocused specialty atlas for RIFLEMAN, BREACHER, GHOST, and SHARPSHOOTER. Base class identities are locked; detailed specialty trees remain tertiary and may contain intentional UNRESOLVED audit slots.","color":"2"},{"id":"back","type":"file","x":-60,"y":-80,"width":360,"height":130,"file":"Maps/Classes.canvas","color":"6"},{"id":"g-rifle","type":"group","x":-100,"y":200,"width":1550,"height":760,"label":"RIFLEMAN","color":"2"},{"id":"g-breach","type":"group","x":1550,"y":200,"width":1550,"height":760,"label":"BREACHER","color":"2"},{"id":"g-ghost","type":"group","x":-100,"y":1080,"width":1550,"height":760,"label":"GHOST","color":"5"},{"id":"g-sharp","type":"group","x":1550,"y":1080,"width":1550,"height":760,"label":"SHARPSHOOTER","color":"3"},{"id":"rifle","type":"file","x":100,"y":350,"width":420,"height":190,"file":"Classes/RIFLEMAN.md","color":"2"},{"id":"gunner","type":"file","x":650,"y":300,"width":330,"height":160,"file":"Specialties/GUNNER.md","color":"2"},{"id":"operator","type":"file","x":650,"y":520,"width":330,"height":160,"file":"Specialties/OPERATOR.md","color":"2"},{"id":"arsenal","type":"file","x":1070,"y":410,"width":330,"height":160,"file":"Specialties/ARSENAL.md","color":"2"},{"id":"breacher","type":"file","x":1750,"y":350,"width":420,"height":190,"file":"Classes/BREACHER.md","color":"2"},{"id":"breaker","type":"file","x":2300,"y":300,"width":330,"height":160,"file":"Specialties/BREAKER.md","color":"2"},{"id":"shock","type":"file","x":2300,"y":520,"width":330,"height":160,"file":"Specialties/SHOCK.md","color":"2"},{"id":"enforcer","type":"file","x":2720,"y":410,"width":330,"height":160,"file":"Specialties/ENFORCER.md","color":"2"},{"id":"ghost","type":"file","x":100,"y":1230,"width":420,"height":190,"file":"Classes/GHOST.md","color":"5"},{"id":"infil","type":"file","x":650,"y":1180,"width":330,"height":160,"file":"Specialties/INFILTRATOR.md","c