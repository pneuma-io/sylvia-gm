{"nodes":[{"id":"title","type":"text","x":-60,"y":-330,"width":820,"height":200,"text":"# SOCIAL & INVESTIGATION\nPeople are influenced through plausible leverage and communication, not social HP. Investigation protects core clues while making evidence quality, provenance and shared knowledge matter.","color":"3"},{"id":"back","type":"file","x":-60,"y":-80,"width":360,"height":130,"file":"Trigger Discipline.canvas","color":"6"},{"id":"socialhub","type":"file","x":410,"y":-80,"width":360,"height":130,"file":"Hubs/Social.md","color":"3"},{"id":"investhub","type":"file","x":880,"y":-80,"width":390,"height":130,"file":"Hubs/Intel & Investigation.md","color":"3"},{"id":"g-social","type":"group","x":-100,"y":180,"width":2200,"height":1500,"label":"SOCIAL","color":"3"},{"id":"g-invest","type":"group","x":2200,"y":180,"width":2100,"height":1500,"label":"INVESTIGATION","color":"5"},{"id":"influencer","type":"file","x":100,"y":350,"width":380,"height":180,"file":"Classes/INFLUENCER.md","color":"3"},{"id":"influencermap","type":"file","x":100,"y":650,"width":380,"height":180,"file":"Maps/Influencer.canvas","color":"3"},{"id":"influence","type":"file","x":600,"y":300,"width":390,"height":180,"file":"Character/Skills/INFLUENCE.md","color":"3"},{"id":"read","type":"file","x":600,"y":560,"width":390,"height":180,"file":"Character/Skills/SOCIAL READ.md","color":"3"},{"id":"fact","type":"file","x":1110,"y":560,"width":360,"height":170,"file":"Social/SOCIAL FACT.md","color":"3"},{"id":"leverage","type":"file","x":1590,"y":560,"width":360,"height":170,"file":"Social/LEVERAGE.md","color":"3"},{"id":"deception","type":"file","x":1110,"y":300,"width":360,"height":170,"file":"Social/DECEPTION.md","color":"3"},{"id":"interrogation","type":"file","x":1590,"y":850,"width":360,"height":170,"file":"Social/INTERROGATION.md","color":"3"},{"id":"morale","type":"file","x":1110,"y":850,"width":360,"height":170,"file":"Social/NPC MORALE.md","color":"3"},{"id":"contact","type":"file","x":600,"y":1060,"width":360,"height":170,"file":"Social/CONTACT.md","color":"3"},{"id":"faction","type":"file","x":1110,"y":1060,"width":390,"height":170,"file":"Social/FACTION REPUTATION.md","color":"3"},{"id":"recon","type":"file","x":2380,"y":330,"width":390,"height":180,"file":"Character/Skills/RECON.md","color":"5"},{"id":"invest","type":"file","x":2380,"y":590,"width":390,"height":180,"file":"Character/Skills/INVESTIGATION.md","color":"5"},{"id":"evidence","type":"file","x":2880,"y":460,"width":390,"height":180,"file":"Investigation/EVIDENCE.md","color":"5"},{"id":"lead","type":"file","x":3390,"y":300,"width":340,"height":160,"file":"Investigation/LEAD.md","color":"5"},{"id":"supported","type":"file","x":3390,"y":540,"width":340,"height":160,"file":"Investigation/SUPPORTED.md","color":"5"},{"id":"verified","type":"file","x":3390,"y":780,"width":340,"height":160,"file":"Investigation/VERIFIED.md","color":"5"},{"id":"knowledge","type":"file","x":2880,"y":860,"width":390,"height":180,"file":"Investigation/TEAM KNOWLEDGE.md","color":"5"},{"id":"weak","type":"file","x":3390,"y":1080,"width":340,"height":160,"file":"Investigation/WEAK POINT.md","color":"5"},{"id":"note","type":"text","x":2380,"y":1210,"width":850,"height":240,"text":"### Investigation principle\nCore clues should not disappear behind one failed roll. Rolls govern speed, completeness, extra conclusions, and complications. Evidence can become progressively better supported and shared with the team.","color":"6"}],"edges":[{"id":"influencer-map","fromNode":"influencer","fromSide":"bottom","toNode":"influencermap","toSide":"top","toEnd":"arrow"},{"id":"influencer-inf","fromNode":"influencer","fromSide":"right","toNode":"influence","toSide":"left","toEnd":"arrow"},{"id":"influencer-read","fromNode":"influencer","fromSide":"right","toNode":"read","toSide":"left","toEnd":"arrow"},{"id":"influencer-contact","fromNode":"influencer","fromSide":"right","toNode":"contact","toSide":"left","toEnd":"arrow"},{"id":"read-fact","fr