{"nodes":[{"id":"title","type":"text","x":-60,"y":-340,"width":900,"height":210,"text":"# DRONES\nA TECH domain. DRONE OPERATIONS is the trained competence for piloting, tasking, and coordinating unmanned systems; ENGINEERING handles building and repair.","color":"5"},{"id":"back","type":"file","x":-60,"y":-80,"width":360,"height":130,"file":"Maps/Technology.canvas","color":"6"},{"id":"tech","type":"file","x":410,"y":-80,"width":360,"height":130,"file":"Classes/TECH.md","color":"5"},{"id":"skill","type":"file","x":890,"y":-80,"width":420,"height":130,"file":"Character/Skills/DRONE OPERATIONS.md","color":"5"},{"id":"hub","type":"file","x":1430,"y":-80,"width":360,"height":130,"file":"Hubs/Drones.md","color":"5"},{"id":"g-core","type":"group","x":-100,"y":180,"width":1200,"height":1000,"label":"DRONE CORE","color":"5"},{"id":"g-auto","type":"group","x":1200,"y":180,"width":1400,"height":1000,"label":"AUTONOMOUS","color":"3"},{"id":"g-fpv","type":"group","x":2700,"y":180,"width":1400,"height":1000,"label":"MANUAL / FPV","color":"4"},{"id":"g-signal","type":"group","x":1200,"y":1280,"width":2900,"height":600,"label":"CONNECTIVITY","color":"6"},{"id":"drone","type":"file","x":100,"y":390,"width":420,"height":200,"file":"Drones/DRONE.md","color":"5"},{"id":"node","type":"file","x":620,"y":390,"width":330,"height":160,"file":"Hacking/NODE.md","color":"4"},{"id":"principle","type":"text","x":100,"y":700,"width":850,"height":250,"text":"### Balance principle\n**AUTONOMOUS:** more simultaneous battlefield presence.\n\n**MANUAL / FPV:** much higher individual drone performance.\n\nHybrid use is valid, but deep specialists outperform generalists.","color":"6"},{"id":"auto-drone","type":"file","x":1380,"y":350,"width":390,"height":180,"file":"Drones/AUTONOMOUS DRONE.md","color":"3"},{"id":"order","type":"file","x":1900,"y":350,"width":390,"height":180,"file":"Drones/STANDING ORDER.md","color":"3"},{"id":"ow","type":"file","x":1900,"y":650,"width":390,"height":180,"file":"Drones/DRONE OVERWATCH.md","color":"3"},{"id":"auto-spec","type":"file","x":1380,"y":760,"width":390,"height":180,"file":"Specialties/AUTODRONES.md","color":"3"},{"id":"fpv-drone","type":"file","x":2880,"y":350,"width":390,"height":180,"file":"Drones/FPV DRONE.md","color":"4"},{"id":"manual","type":"file","x":3400,"y":350,"width":390,"height":180,"file":"Drones/MANUAL CONTROL.md","color":"4"},{"id":"fpv-spec","type":"file","x":2880,"y":760,"width":390,"height":180,"file":"Specialties/FPV DRONES.md","color":"4"},{"id":"signal","type":"file","x":1550,"y":1450,"width":430,"height":180,"file":"Drones/SIGNAL.md","color":"6"},{"id":"loss","type":"file","x":2200,"y":1450,"width":430,"height":180,"file":"Drones/LOSS OF SIGNAL.md","color":"6"}],"edges":[{"id":"tech-skill","fromNode":"tech","fromSide":"right","toNode":"skill","toSide":"left","toEnd":"arrow"},{"id":"skill-drone","fromNode":"skill","fromSide":"bottom","toNode":"drone","toSide":"top","toEnd":"arrow"},{"id":"drone-node","fromNode":"drone","fromSide":"right","toNode":"node","toSide":"left","toEnd":"arrow"},{"id":"drone-auto","fromNode":"drone","fromSide":"right","toNode":"auto-drone","toSide":"left","toEnd":"arrow"},{"id":"auto-order","fromNode":"auto-drone","fromSide":"right","toNode":"order","toSide":"left","toEnd":"arrow"},{"id":"order-ow","fromNode":"order","fromSide":"bottom","toNode":"ow","toSide":"top","toEnd":"arrow"},{"id":"auto-spec-edge","fromNode":"auto-drone","fromSide":"bottom","toNode":"auto-spec","toSide":"top","toEnd":"arrow"},{"id":"drone-fpv","fromNode":"drone","fromSide":"right","toNode":"fpv-drone","toSide":"left","toEnd":"arrow"},{"id":"fpv-manual","fromNode":"fpv-drone","fromSide":"right","toNode":"manual","toSide":"left","toEnd":"arrow"},{"id":"fpv-spec-edge","fromNode":"fpv-drone","fromSide":"bottom","toNode":"fpv-spec","toSide":"top","toEnd":"arrow"},{"id":"drone-signal","fromNode":"drone","fromSide":"bottom","toNode":"signal","toSide":"top","toEnd":"arrow"},{"id":"signal-loss","fromNode":"signal","fromSide":"right","toNode":"loss","toSide":"left","toEnd":"arrow"}]}