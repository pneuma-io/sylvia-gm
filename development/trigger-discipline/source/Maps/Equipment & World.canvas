{"nodes":[{"id":"title","type":"text","x":-60,"y":-320,"width":820,"height":190,"text":"# EQUIPMENT & WORLD\nWhere gear is carried changes access time. Protection remains physical and directional. Environmental hazards use specific physical behavior rather than one generic damage subsystem.","color":"6"},{"id":"back","type":"file","x":-60,"y":-80,"width":360,"height":130,"file":"Trigger Discipline.canvas","color":"6"},{"id":"eqhub","type":"file","x":410,"y":-80,"width":360,"height":130,"file":"Hubs/Equipment.md","color":"6"},{"id":"envhub","type":"file","x":880,"y":-80,"width":360,"height":130,"file":"Hubs/Environment.md","color":"6"},{"id":"g-inv","type":"group","x":-100,"y":180,"width":1800,"height":1000,"label":"INVENTORY & ACCESS","color":"6"},{"id":"g-protect","type":"group","x":1800,"y":180,"width":1450,"height":1000,"label":"PROTECTION","color":"5"},{"id":"g-env","type":"group","x":3350,"y":180,"width":1800,"height":1200,"label":"ENVIRONMENT","color":"3"},{"id":"inventory","type":"file","x":100,"y":380,"width":420,"height":190,"file":"Equipment/INVENTORY.md","color":"6"},{"id":"ready","type":"file","x":650,"y":300,"width":330,"height":160,"file":"Equipment/READY.md","color":"6"},{"id":"quick","type":"file","x":650,"y":530,"width":330,"height":160,"file":"Equipment/QUICK ACCESS.md","color":"6"},{"id":"stowed","type":"file","x":650,"y":760,"width":330,"height":160,"file":"Equipment/STOWED.md","color":"6"},{"id":"mag","type":"file","x":1100,"y":420,"width":360,"height":160,"file":"Firearms/MAGAZINE.md","color":"1"},{"id":"ammo","type":"file","x":1100,"y":680,"width":360,"height":160,"file":"Firearms/AMMUNITION.md","color":"1"},{"id":"armor","type":"file","x":1990,"y":350,"width":380,"height":180,"file":"Equipment/BODY ARMOR.md","color":"5"},{"id":"shield","type":"file","x":2490,"y":350,"width":390,"height":180,"file":"Equipment/BALLISTIC SHIELD.md","color":"5"},{"id":"barrier","type":"file","x":2490,"y":650,"width":390,"height":180,"file":"Equipment/BARRIER.md","color":"5"},{"id":"fire","type":"file","x":3550,"y":330,"width":330,"height":160,"file":"Environment/FIRE.md","color":"3"},{"id":"smoke","type":"file","x":4000,"y":330,"width":330,"height":160,"file":"Environment/SMOKE.md","color":"3"},{"id":"toxic","type":"file","x":4450,"y":330,"width":350,"height":160,"file":"Environment/TOXIC GAS.md","color":"3"},{"id":"water","type":"file","x":3550,"y":650,"width":330,"height":160,"file":"Environment/WATER.md","color":"3"},{"id":"electric","type":"file","x":4000,"y":650,"width":360,"height":160,"file":"Environment/ELECTRICITY.md","color":"3"},{"id":"vehicles","type":"file","x":3550,"y":980,"width":390,"height":180,"file":"Character/Skills/VEHICLES.md","color":"6"},{"id":"note","type":"text","x":4100,"y":950,"width":800,"height":250,"text":"### Scope\nRoutine driving needs no roll. VEHICLES covers uncertain or demanding operation. Tactical vehicle combat remains outside the current core rules.\n\nEquipment quality changes physical parameters, not a universal +2 quality bonus.","color":"6"}],"edges":[{"id":"inv-ready","fromNode":"inventory","fromSide":"right","fromEnd":"none","toNode":"ready","toSide":"left","toEnd":"arrow"},{"id":"inv-quick","fromNode":"inventory","fromSide":"right","fromEnd":"none","toNode":"quick","toSide":"left","toEnd":"arrow"},{"id":"inv-stow","fromNode":"inventory","fromSide":"right","fromEnd":"none","toNode":"stowed","toSide":"left","toEnd":"arrow"},{"id":"inv-mag","fromNode":"inventory","fromSide":"right","fromEnd":"none","toNode":"mag","toSide":"left","toEnd":"arrow"},{"id":"inv-ammo","fromNode":"inventory","fromSide":"right","fromEnd":"none","toNode":"ammo","toSide":"left","toEnd":"arrow"},{"id":"armor-shield","fromNode":"armor","fromSide":"right","fromEnd":"none","toNode":"shield","toSide":"left","toEnd":"arrow"},{"id":"shield-barrier","fromNode":"shield","fromSide":"bottom","fromEnd":"none","toNode":"barrier","toSide":"top","toEnd":"arrow"},{"id":"fire-smoke","fromNode":"fire","fromSide":"right","fromEnd":"none","toNode":"smoke","toSide":"left","toEnd":"arrow"},{"id":"smoke-toxic","fromNode":"smoke","fromSide":"right","fromEnd":"none","toNode":"toxic","toSide":"left","toEnd":"arrow"},{"id":"water-electric","fromNode":"water","fromSide":"right","fromEnd":"none","toNode":"electric","toSide":"left","toEnd":"arrow"}]}