{"nodes":[{"id":"title","type":"text","x":-60,"y":-310,"width":900,"height":190,"text":"# CQC\nCQC is a locked discrete-maneuver system against derived CQC DEFENSE. One action attempts one physical result; spending more AP can chain maneuvers into natural combos.","color":"2"},{"id":"back","type":"file","x":-60,"y":-80,"width":340,"height":130,"file":"Maps/Combat.canvas","color":"6"},{"id":"hub","type":"file","x":390,"y":-80,"width":360,"height":130,"file":"Hubs/CQC Combat.md","color":"2"},{"id":"g-core","type":"group","x":-100,"y":180,"width":1450,"height":900,"label":"CORE","color":"2"},{"id":"g-moves","type":"group","x":1450,"y":180,"width":2050,"height":1450,"label":"MANEUVERS","color":"2"},{"id":"action","type":"file","x":100,"y":350,"width":420,"height":200,"file":"CQC/CQC ACTION.md","color":"2"},{"id":"defense","type":"file","x":650,"y":300,"width":390,"height":180,"file":"CQC/CQC DEFENSE.md","color":"2"},{"id":"brace","type":"file","x":650,"y":600,"width":390,"height":180,"file":"CQC/CQC BRACE.md","color":"2"},{"id":"throw","type":"file","x":1630,"y":330,"width":380,"height":180,"file":"CQC/THROW.md","color":"2"},{"id":"trip","type":"file","x":2130,"y":330,"width":380,"height":180,"file":"CQC/TRIP.md","color":"2"},{"id":"control","type":"file","x":2630,"y":330,"width":380,"height":180,"file":"CQC/CONTROL.md","color":"2"},{"id":"disarm","type":"file","x":1630,"y":650,"width":380,"height":180,"file":"CQC/DISARM.md","color":"2"},{"id":"shove","type":"file","x":2130,"y":650,"width":380,"height":180,"file":"CQC/SHOVE.md","color":"2"},{"id":"escape","type":"file","x":2630,"y":650,"width":380,"height":180,"file":"CQC/ESCAPE.md","color":"2"},{"id":"combo","type":"text","x":1630,"y":980,"width":1380,"height":300,"text":"### Natural combo grammar\nEach maneuver resolves only its own physical result.\n\n**SHOVE** = move · **TRIP** = PRONE · **THROW** = move + PRONE · **DISARM** = lose held item · **CONTROL** = persistent physical denial · **ESCAPE** = end CONTROL.\n\nWant several consequences? Spend AP on several actions.","color":"6"}],"edges":[{"id":"action-defense","fromNode":"action","fromSide":"right","fromEnd":"none","toNode":"defense","toSide":"left","toEnd":"arrow"},{"id":"action-brace","fromNode":"action","fromSide":"right","fromEnd":"none","toNode":"brace","toSide":"left","toEnd":"arrow"},{"id":"action-throw","fromNode":"action","fromSide":"right","fromEnd":"none","toNode":"throw","toSide":"left","toEnd":"arrow"},{"id":"action-trip","fromNode":"action","fromSide":"right","fromEnd":"none","toNode":"trip","toSide":"left","toEnd":"arrow"},{"id":"action-control","fromNode":"action","fromSide":"right","fromEnd":"none","toNode":"control","toSide":"left","toEnd":"arrow"},{"id":"action-disarm","fromNode":"action","fromSide":"right","fromEnd":"none","toNode":"disarm","toSide":"left","toEnd":"arrow"},{"id":"action-shove","fromNode":"action","fromSide":"right","fromEnd":"none","toNode":"shove","toSide":"left","toEnd":"arrow"},{"id":"control-escape","fromNode":"control","fromSide":"bottom","fromEnd":"none","toNode":"escape","toSide":"top","toEnd":"arrow","label":"break hold"}]}