{"nodes":[{"id":"title","type":"text","x":-60,"y":-330,"width":900,"height":210,"text":"# TECHNOLOGY\nTwo distinct class fantasies share the same technological world:\n\n**TECH operates systems. HACKER subverts systems.**","color":"4"},{"id":"back","type":"file","x":-60,"y":-70,"width":350,"height":130,"file":"Trigger Discipline.canvas","color":"6"},{"id":"classes","type":"file","x":390,"y":-70,"width":360,"height":130,"file":"Maps/Classes.canvas","color":"2"},{"id":"hub","type":"file","x":850,"y":-70,"width":360,"height":130,"file":"Hubs/Technology.md","color":"4"},{"id":"g-tech","type":"group","x":-100,"y":190,"width":2350,"height":1350,"label":"TECH — USE / DEPLOY / OPERATE","color":"5"},{"id":"g-hacker","type":"group","x":2400,"y":190,"width":2350,"height":1350,"label":"HACKER — ACCESS / EXPLOIT / SUBVERT","color":"4"},{"id":"tech","type":"file","x":120,"y":390,"width":560,"height":240,"file":"Classes/TECH.md","color":"5"},{"id":"engineering","type":"file","x":820,"y":300,"width":470,"height":190,"file":"Character/Skills/ENGINEERING.md","color":"5"},{"id":"droneops","type":"file","x":820,"y":560,"width":470,"height":190,"file":"Character/Skills/DRONE OPERATIONS.md","color":"5"},{"id":"drones","type":"file","x":1460,"y":300,"width":520,"height":210,"file":"Maps/Drones.canvas","color":"5"},{"id":"field","type":"file","x":1460,"y":580,"width":470,"height":180,"file":"Specialties/FIELD ENGINEER.md","color":"5"},{"id":"fpv","type":"file","x":820,"y":900,"width":470,"height":180,"file":"Specialties/FPV DRONES.md","color":"5"},{"id":"auto","type":"file","x":1460,"y":900,"width":470,"height":180,"file":"Specialties/AUTODRONES.md","color":"5"},{"id":"techrule","type":"text","x":250,"y":1160,"width":1650,"height":220,"text":"### TECH boundary\nUsing a device's intended controls, maintaining it, configuring it, deploying it, or piloting it is TECH territory. Security bypass and hostile privilege escalation are not.","color":"6"},{"id":"hacker","type":"file","x":2620,"y":390,"width":560,"height":240,"file":"Classes/HACKER.md","color":"4"},{"id":"localSkill","type":"file","x":3320,"y":300,"width":470,"height":190,"file":"Character/Skills/LOCAL HACKING.md","color":"4"},{"id":"netSkill","type":"file","x":3320,"y":560,"width":470,"height":190,"file":"Character/Skills/NETWORKING.md","color":"4"},{"id":"hacking","type":"file","x":3960,"y":300,"width":520,"height":210,"file":"Maps/Hacking.canvas","color":"4"},{"id":"local","type":"file","x":3960,"y":620,"width":470,"height":180,"file":"Specialties/LOCAL HACKER.md","color":"4"},{"id":"networker","type":"file","x":3320,"y":900,"width":470,"height":180,"file":"Specialties/NETWORKER.md","color":"4"},{"id":"hackrule","type":"text","x":2750,"y":1160,"width":1650,"height":220,"text":"### HACKER boundary\nUnderstanding unfamiliar internals, bypassing security, stealing credentials, gaining privilege, modifying protected behavior, or pivoting through topology is HACKER territory.","color":"6"}],"edges":[{"id":"tech-eng","fromNode":"tech","fromSide":"right","toNode":"engineering","toSide":"left","toEnd":"arrow"},{"id":"tech-droneops","fromNode":"tech","fromSide":"right","toNode":"droneops","toSide":"left","toEnd":"arrow"},{"id":"droneops-drones","fromNode":"droneops","fromSide":"right","toNode":"drones","toSide":"left","toEnd":"arrow"},{"id":"eng-field","fromNode":"engineering","fromSide":"right","toNode":"field","toSide":"left","toEnd":"arrow"},{"id":"droneops-fpv","fromNode":"droneops","fromSide":"bottom","toNode":"fpv","toSide":"top","toEnd":"arrow"},{"id":"drones-auto","fromNode":"drones","fromSide":"bottom","toNode":"auto","toSide":"top","toEnd":"arrow"},{"id":"hack-local-skill","fromNode":"hacker","fromSide":"right","toNode":"localSkill","toSide":"left","toEnd":"arrow"},{"id":"hack-net-skill","fromNode":"hacker","fromSide":"right","toNode":"netSkill","toSide":"left","toEnd":"arrow"},{"id":"skills-hacking","fromNode":"localSkill","fromSide":"right","toNode":"hacking","toSide":"left","toEnd":"arrow"},{"id":"hack-local","fromNode":"hacking","fromSide":"bottom","toNode":"local","toSide":"top","toEnd":"arrow"},{"id":"net-networker","fromNode":"netSkill","fromSide":"bottom","toNode":"networker","toSide":"top","toEnd":"arrow"}]}