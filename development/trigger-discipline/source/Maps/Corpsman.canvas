{"nodes":[{"id":"title","type":"text","x":-60,"y":-300,"width":980,"height":200,"text":"# CORPSMAN\nMedical capability is not class-gated. CORPSMAN starts with CLINICAL TEMPO; specialties deepen immediate battlefield function, serious trauma care, or injury-specific critical care. DOWNED and LIFE-THREATENING CONDITION are separate states.","color":"3"},{"id":"back","type":"file","x":-60,"y":-70,"width":360,"height":130,"file":"Maps/Classes.canvas","color":"6"},{"id":"corpsman","type":"file","x":420,"y":-80,"width":440,"height":160,"file":"Classes/CORPSMAN.md","color":"3"},{"id":"medicine","type":"file","x":980,"y":-80,"width":440,"height":160,"file":"Character/Skills/MEDICINE.md","color":"3"},{"id":"g-spec","type":"group","x":-100,"y":200,"width":3000,"height":1150,"label":"LOCKED SPECIALTY IDENTITIES — TERTIARY TREES","color":"3"},{"id":"field","type":"file","x":100,"y":370,"width":620,"height":260,"file":"Specialties/FIELD MEDIC.md","color":"5"},{"id":"trauma","type":"file","x":950,"y":370,"width":620,"height":260,"file":"Specialties/TRAUMA.md","color":"2"},{"id":"resus","type":"file","x":1800,"y":370,"width":620,"height":260,"file":"Specialties/RESUSCITATOR.md","color":"1"},{"id":"res","type":"file","x":100,"y":740,"width":420,"height":170,"file":"Combat/RES.md","color":"5"},{"id":"hp","type":"file","x":1050,"y":740,"width":420,"height":170,"file":"Combat/HP.md","color":"2"},{"id":"downed","type":"file","x":1900,"y":740,"width":420,"height":170,"file":"Combat/DOWNED.md","color":"1"},{"id":"life","type":"file","x":1700,"y":1010,"width":520,"height":170,"file":"Combat/LIFE-THREATENING CONDITION.md","color":"1"},{"id":"stabilize","type":"file","x":2250,"y":1010,"width":300,"height":160,"file":"Combat/STABILIZE.md","color":"1"},{"id":"resuscitation","type":"file","x":2580,"y":1010,"width":300,"height":160,"file":"Combat/RESUSCITATION.md","color":"1"}],"edges":[{"id":"c-field","fromNode":"corpsman","fromSide":"bottom","toNode":"field","toSide":"top","toEnd":"arrow"},{"id":"c-trauma","fromNode":"corpsman","fromSide":"bottom","toNode":"trauma","toSide":"top","toEnd":"arrow"},{"id":"c-resus","fromNode":"corpsman","fromSide":"bottom","toNode":"resus","toSide":"top","toEnd":"arrow"},{"id":"m-field","fromNode":"medicine","fromSide":"bottom","toNode":"field","toSide":"top","toEnd":"arrow"},{"id":"m-trauma","fromNode":"medicine","fromSide":"bottom","toNode":"trauma","toSide":"top","toEnd":"arrow"},{"id":"m-resus","fromNode":"medicine","fromSide":"bottom","toNode":"resus","toSide":"top","toEnd":"arrow"},{"id":"field-res","fromNode":"field","fromSide":"bottom","toNode":"res","toSide":"top","toEnd":"arrow"},{"id":"trauma-hp","fromNode":"trauma","fromSide":"bottom","toNode":"hp","toSide":"top","toEnd":"arrow"},{"id":"resus-downed","fromNode":"resus","fromSide":"bottom","toNode":"downed","toSide":"top","toEnd":"arrow"},{"id":"downed-life","fromNode":"downed","fromSide":"bottom","toNode":"life","toSide":"top","toEnd":"arrow","label":"when an actual life threat exists"},{"id":"life-stabilize","fromNode":"life","fromSide":"right","toNode":"stabilize","toSide":"left","toEnd":"arrow","label":"ACTIVE"},{"id":"life-resuscitation","fromNode":"life","fromSide":"right","toNode":"resuscitation","toSide":"left","toEnd":"arrow","label":"reversible FAILED"}]}